@model SDP1.Models.CommunityModerationViewModel
@{
    ViewData["Title"] = "Community Moderation";
}

<div class="container-fluid py-4 px-md-5">
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #EAF4FF 0%, #FFFFFF 100%); border-left: 5px solid #2563EB !important;">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 52px; height: 52px; background-color: #2563EB; color: #fff; font-size: 24px;">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                    <h2 class="h3 fw-bold mb-1 text-dark">Admin Community Moderation</h2>
                    <p class="text-muted mb-0">Manage community discussions, monitor posts and comments, and keep conversations safe.</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-4">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                <a href="/Community" class="btn btn-primary fw-semibold rounded-pill px-4" style="background-color: #2563EB; border-color: #2563EB;">
                    <i class="fas fa-comments me-1"></i> Community Feed
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Posts</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalPostsCount</h3>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #EAF4FF; color: #2563EB;">
                    <i class="fas fa-file-alt"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Comments</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalCommentsCount</h3>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #EAF4FF; color: #2563EB;">
                    <i class="fas fa-comments"></i>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills mb-4 gap-2" id="moderationTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold @(Model.ActiveTab != "comments" ? "active" : "")" id="posts-tab" data-bs-toggle="pill" data-bs-target="#tab-posts" type="button" role="tab">
                <i class="fas fa-file-alt me-1"></i> Posts (@Model.TotalPostsCount)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold @(Model.ActiveTab == "comments" ? "active" : "")" id="comments-tab" data-bs-toggle="pill" data-bs-target="#tab-comments" type="button" role="tab">
                <i class="fas fa-comments me-1"></i> Comments (@Model.TotalCommentsCount)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="moderationTabsContent">
        <div class="tab-pane fade @(Model.ActiveTab != "comments" ? "show active" : "")" id="tab-posts" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Author</th>
                                <th>Content Preview</th>
                                <th>Created</th>
                                <th>Likes</th>
                                <th>Comments</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllPosts.Any())
                            {
                                @foreach (var p in Model.AllPosts)
                                {
                                    <tr class="@(p.IsDeleted ? "table-secondary text-muted" : p.IsHidden ? "table-warning" : "")">
                                        <td class="fw-bold">#@p.Id</td>
                                        <td>
                                            <strong>@p.AuthorName</strong>
                                            <span class="badge @(p.UserRole == "Admin" ? "bg-danger" : p.UserRole == "Volunteer" ? "bg-primary" : p.UserRole == "Organization" ? "bg-info" : "bg-primary") ms-1 small">
                                                @p.UserRole
                                            </span>
                                        </td>
                                        <td style="max-width: 320px;">
                                            <div class="text-truncate" title="@p.Content">@p.Content</div>
                                            @if (!string.IsNullOrEmpty(p.ImagePath))
                                            {
                                                <small class="text-primary"><i class="fas fa-image me-1"></i> Has Image</small>
                                            }
                                        </td>
                                        <td class="small text-muted">@p.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@p.Likes.Count</span></td>
                                        <td><span class="badge bg-light text-dark border">@p.Comments.Count</span></td>
                                        <td>
                                            @if (p.IsDeleted)
                                            {
                                                <span class="badge bg-secondary">Deleted</span>
                                            }
                                            else if (p.IsHidden)
                                            {
                                                <span class="badge bg-warning text-dark">Hidden</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Active</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!p.IsDeleted)
                                            {
                                                <div class="d-inline-flex gap-1">
                                                    <a href="/Community/Details/@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View post and comments">
                                                        <i class="fas fa-eye me-1"></i> View & Comment
                                                    </a>
                                                    <form asp-controller="Community" asp-action="ToggleHidePost" asp-route-id="@p.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(p.IsHidden ? "btn-outline-primary" : "btn-outline-secondary") rounded-pill px-3" title="@(p.IsHidden ? "Unhide" : "Hide")">
                                                            @(p.IsHidden ? "Unhide" : "Hide")
                                                        </button>
                                                    </form>
                                                    <form asp-controller="Community" asp-action="DeletePost" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Permanently delete this post?');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Removed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No posts available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(Model.ActiveTab == "comments" ? "show active" : "")" id="tab-comments" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Author</th>
                                <th>Post</th>
                                <th>Comment Content</th>
                                <th>Created</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllComments.Any())
                            {
                                @foreach (var c in Model.AllComments)
                                {
                                    <tr class="@(c.IsDeleted ? "table-secondary text-muted" : c.IsHidden ? "table-warning" : "")">
                                        <td class="fw-bold">#@c.Id</td>
                                        <td>
                                            <strong>@c.AuthorName</strong>
                                            <span class="badge @(c.UserRole == "Admin" ? "bg-danger" : c.UserRole == "Volunteer" ? "bg-primary" : c.UserRole == "Organization" ? "bg-info" : "bg-primary") ms-1 small">
                                                @c.UserRole
                                            </span>
                                        </td>
                                        <td>
                                            @if (c.Post != null)
                                            {
                                                <a href="/Community#post-@c.CommunityPostId" target="_blank" class="small text-decoration-none">
                                                    Post #@c.CommunityPostId <i class="fas fa-external-link-alt ms-1 text-xs"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Post #@c.CommunityPostId</span>
                                            }
                                        </td>
                                        <td style="max-width: 320px;">
                                            <div class="text-truncate" title="@c.Content">@c.Content</div>
                                        </td>
                                        <td class="small text-muted">@c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (c.IsDeleted)
                                            {
                                                <span class="badge bg-secondary">Deleted</span>
                                            }
                                            else if (c.IsHidden)
                                            {
                                                <span class="badge bg-warning text-dark">Hidden</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Active</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!c.IsDeleted)
                                            {
                                                <div class="d-inline-flex gap-1">
                                                    <a href="/Community/Details/@c.CommunityPostId" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="View in discussion">
                                                        <i class="fas fa-eye me-1"></i> View
                                                    </a>
                                                    <form asp-controller="Community" asp-action="ToggleHideComment" asp-route-id="@c.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(c.IsHidden ? "btn-outline-primary" : "btn-outline-secondary") rounded-pill px-3">
                                                            @(c.IsHidden ? "Unhide" : "Hide")
                                                        </button>
                                                    </form>
                                                    <form asp-controller="Community" asp-action="DeleteComment" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Permanently delete this comment?');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Removed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No comments available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

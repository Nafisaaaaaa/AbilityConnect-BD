@model SDP1.Models.CommunityReportCreateViewModel
@{
    ViewData["Title"] = "Community Report";
    var currentType = Model.ReportType;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/Community" class="text-decoration-none">Community</a></li>
                <li class="breadcrumb-item active" aria-current="page">Submit Report</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fas fa-flag text-danger me-2"></i>Community Report
                </h2>
                <p class="text-muted mb-0">Help keep our community safe, inclusive, and accessible by reporting issues or barriers.</p>
            </div>
            <a href="/Community" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Community
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-3 bg-light">
            <div class="nav nav-pills nav-justified" id="reportTypeTabs" role="tablist">
                <button class="nav-link py-3 rounded-3 @(currentType == "Location" ? "active" : "")" 
                        id="tab-location-btn" 
                        type="button" 
                        onclick="switchReportType('Location')">
                    <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                    <strong>Physical Location / Barrier</strong>
                    <div class="small opacity-75 d-none d-md-block">Missing ramps, difficult entrance, inaccessible facility</div>
                </button>
                <button class="nav-link py-3 rounded-3 @(currentType == "Post" ? "active" : "")" 
                        id="tab-post-btn" 
                        type="button" 
                        onclick="switchReportType('Post')">
                    <i class="fas fa-newspaper me-2 text-primary"></i>
                    <strong>Community Post</strong>
                    <div class="small opacity-75 d-none d-md-block">Inappropriate post, harassment, or spam</div>
                </button>
                <button class="nav-link py-3 rounded-3 @(currentType == "Comment" ? "active" : "")" 
                        id="tab-comment-btn" 
                        type="button" 
                        onclick="switchReportType('Comment')">
                    <i class="fas fa-comment me-2 text-info"></i>
                    <strong>Comment</strong>
                    <div class="small opacity-75 d-none d-md-block">Offensive or misleading comment</div>
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-controller="Community" asp-action="ReportContent" method="post" id="reportForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="formReportType" name="ReportType" value="@currentType" />

                <div id="section-location" class="@(currentType == "Location" ? "" : "d-none")">
                    <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-center">
                        <i class="fas fa-info-circle fa-2x me-3 text-primary"></i>
                        <div>
                            <strong>Physical Accessibility Barrier Reporting:</strong>
                            <div class="small">Search for a location or click anywhere on the OpenStreetMap below to drop a pin. Our moderation team will verify the barrier and update accessibility resources.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">
                            <i class="fas fa-search-location me-1 text-primary"></i> Search Location (OpenStreetMap)
                        </label>
                        <div class="input-group">
                            <input type="text" id="mapSearchInput" class="form-control" placeholder="Type a place name, building, street, or city (e.g., Dhaka Medical College, Dhanmondi 27)..." />
                            <button type="button" class="btn btn-primary px-4" id="searchLocationBtn" onclick="searchNominatim()">
                                <i class="fas fa-search me-1"></i> Search
                            </button>
                        </div>
                        <div id="searchResults" class="list-group mt-2 shadow-sm d-none" style="max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-map me-1 text-primary"></i> Pinpoint Location on Map</span>
                            <span class="small text-muted fw-normal"><i class="fas fa-hand-pointer me-1"></i> Click on map to move marker</span>
                        </label>
                        <div id="osmMap" style="height: 380px; width: 100%; border-radius: 12px; border: 1px solid #dee2e6; z-index: 1;"></div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Place / Building Name <span class="text-danger">*</span></label>
                            <input type="text" id="inputPlaceName" name="PlaceName" value="@Model.PlaceName" class="form-control rounded-3" placeholder="e.g., City Center Shopping Mall, Branch 3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Address / Street</label>
                            <input type="text" id="inputAddress" name="Address" value="@Model.Address" class="form-control rounded-3" placeholder="e.g., Road 12, Banani, Dhaka" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Latitude</label>
                            <input type="number" step="any" id="inputLatitude" name="Latitude" value="@Model.Latitude" class="form-control rounded-3 bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">Longitude</label>
                            <input type="number" step="any" id="inputLongitude" name="Longitude" value="@Model.Longitude" class="form-control rounded-3 bg-light" readonly />
                        </div>
                    </div>
                </div>

                <div id="section-post" class="@(currentType == "Post" ? "" : "d-none")">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">
                            <i class="fas fa-newspaper me-1 text-primary"></i> Target Post ID <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="inputPostId" name="PostId" value="@Model.PostId" class="form-control rounded-3" placeholder="Enter the Community Post ID" />
                        @if (Model.AvailablePosts.Any())
                        {
                            var targetPost = Model.AvailablePosts.First();
                            <div class="card border rounded-3 p-3 mt-2 bg-light">
                                <div class="fw-bold text-dark small mb-1">Post by @targetPost.AuthorName:</div>
                                <div class="text-muted small">@targetPost.Content</div>
                            </div>
                        }
                    </div>
                </div>

                <div id="section-comment" class="@(currentType == "Comment" ? "" : "d-none")">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">
                            <i class="fas fa-comment me-1 text-primary"></i> Target Comment ID <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="inputCommentId" name="CommentId" value="@Model.CommentId" class="form-control rounded-3" placeholder="Enter the Community Comment ID" />
                        @if (Model.AvailableComments.Any())
                        {
                            var targetComment = Model.AvailableComments.First();
                            <div class="card border rounded-3 p-3 mt-2 bg-light">
                                <div class="fw-bold text-dark small mb-1">Comment by @targetComment.AuthorName:</div>
                                <div class="text-muted small">@targetComment.Content</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">
                        <i class="fas fa-exclamation-triangle me-1 text-warning"></i> Reason for Reporting <span class="text-danger">*</span>
                    </label>
                    <select id="selectReason" name="Reason" class="form-select rounded-3" required>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">
                        <i class="fas fa-align-left me-1 text-primary"></i> Detailed Description
                    </label>
                    <textarea name="Details" id="inputDetails" rows="4" class="form-control rounded-3" placeholder="Describe the barrier, obstacle, or inappropriate behavior with specific details...">@Model.Details</textarea>
                    <div class="form-text">Your submission helps maintain accessibility standards and community integrity.</div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Community" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-semibold shadow-sm">
                        <i class="fas fa-paper-plane me-1"></i> Submit Community Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentType = '@currentType';
        let map = null;
        let marker = null;

        const locationReasons = [
            "Difficult Entrance",
            "Missing Ramp",
            "Broken Elevator",
            "Inaccessible Toilet",
            "No Wheelchair Access",
            "Broken Facility",
            "Narrow Doorways",
            "Obstacles on Walkway",
            "Other"
        ];

        const contentReasons = [
            "Spam",
            "Inappropriate Content",
            "Harassment",
            "Misleading Information",
            "Hate Speech",
            "Other"
        ];

        function populateReasons(type) {
            const select = document.getElementById('selectReason');
            select.innerHTML = '';
            const reasons = (type === 'Location') ? locationReasons : contentReasons;
            reasons.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                if (r === '@Model.Reason') {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
        }

        function switchReportType(type) {
            currentType = type;
            document.getElementById('formReportType').value = type;

            document.getElementById('tab-location-btn').classList.toggle('active', type === 'Location');
            document.getElementById('tab-post-btn').classList.toggle('active', type === 'Post');
            document.getElementById('tab-comment-btn').classList.toggle('active', type === 'Comment');

            document.getElementById('section-location').classList.toggle('d-none', type !== 'Location');
            document.getElementById('section-post').classList.toggle('d-none', type !== 'Post');
            document.getElementById('section-comment').classList.toggle('d-none', type !== 'Comment');

            populateReasons(type);

            if (type === 'Location') {
                setTimeout(() => {
                    if (map) {
                        map.invalidateSize();
                    } else {
                        initLeafletMap();
                    }
                }, 100);
            }
        }

        function initLeafletMap() {
            if (map) return;

            const initialLat = parseFloat(document.getElementById('inputLatitude').value) || 23.8103;
            const initialLng = parseFloat(document.getElementById('inputLongitude').value) || 90.4125;

            map = L.map('osmMap').setView([initialLat, initialLng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);

            marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            marker.on('dragend', function (e) {
                const pos = marker.getLatLng();
                updateCoordinates(pos.lat, pos.lng);
                reverseGeocode(pos.lat, pos.lng);
            });

            map.on('click', function (e) {
                const lat = e.latlng.lat;
                const lng = e.latlng.lng;
                marker.setLatLng([lat, lng]);
                updateCoordinates(lat, lng);
                reverseGeocode(lat, lng);
            });
        }

        function updateCoordinates(lat, lng) {
            document.getElementById('inputLatitude').value = lat.toFixed(6);
            document.getElementById('inputLongitude').value = lng.toFixed(6);
        }

        async function reverseGeocode(lat, lng) {
            try {
                const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`;
                const response = await fetch(url, { headers: { 'Accept-Language': 'en' } });
                if (response.ok) {
                    const data = await response.json();
                    if (data && data.display_name) {
                        const addrInput = document.getElementById('inputAddress');
                        const placeInput = document.getElementById('inputPlaceName');
                        if (!placeInput.value) {
                            placeInput.value = data.name || data.address?.amenity || data.address?.building || data.address?.road || '';
                        }
                        addrInput.value = data.display_name;
                    }
                }
            } catch (err) {
                console.error("Reverse geocoding error:", err);
            }
        }

        async function searchNominatim() {
            const query = document.getElementById('mapSearchInput').value.trim();
            if (!query) return;

            const resultsContainer = document.getElementById('searchResults');
            resultsContainer.innerHTML = '<div class="list-group-item text-muted small"><i class="fas fa-spinner fa-spin me-2"></i>Searching OpenStreetMap...</div>';
            resultsContainer.classList.remove('d-none');

            try {
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5&addressdetails=1`;
                const response = await fetch(url, { headers: { 'Accept-Language': 'en' } });
                const results = await response.json();

                resultsContainer.innerHTML = '';
                if (!results || results.length === 0) {
                    resultsContainer.innerHTML = '<div class="list-group-item text-muted small">No places found. Try refining your search.</div>';
                    return;
                }

                results.forEach(item => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'list-group-item list-group-item-action text-start small';
                    btn.innerHTML = `<i class="fas fa-map-marker-alt text-danger me-2"></i><strong>${item.name || item.display_name.split(',')[0]}</strong><div class="text-muted" style="font-size: 0.75rem;">${item.display_name}</div>`;
                    btn.onclick = () => {
                        const lat = parseFloat(item.lat);
                        const lon = parseFloat(item.lon);
                        map.setView([lat, lon], 16);
                        marker.setLatLng([lat, lon]);
                        updateCoordinates(lat, lon);
                        document.getElementById('inputPlaceName').value = item.name || item.display_name.split(',')[0];
                        document.getElementById('inputAddress').value = item.display_name;
                        resultsContainer.classList.add('d-none');
                    };
                    resultsContainer.appendChild(btn);
                });
            } catch (err) {
                resultsContainer.innerHTML = '<div class="list-group-item text-danger small">Error searching places. Please try again.</div>';
            }
        }

        document.getElementById('mapSearchInput').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                searchNominatim();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            populateReasons(currentType);
            if (currentType === 'Location') {
                initLeafletMap();
            }
        });
    </script>
}

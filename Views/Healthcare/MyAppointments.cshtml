@model List<SDP1.Models.HealthcareAppointment>
@{
    ViewData["Title"] = "My Doctor Appointments";
    var pendingCount = Model.Count(a => a.Status == "Pending");
    var confirmedCount = Model.Count(a => a.Status == "Confirmed");
    var completedCount = Model.Count(a => a.Status == "Completed");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/"><i class="fas fa-home"></i> Home</a></li>
                <li class="breadcrumb-item"><a href="/Healthcare">Healthcare Finder</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Appointments</li>
            </ol>
        </nav>
        <a href="/Disability/Dashboard" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #E8F0FE 0%, #FFFFFF 100%); border-left: 5px solid #4A90D9 !important; border-radius: 12px;">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="fw-bold mb-1" style="color: #2D3748;">My Healthcare & Therapy Appointments</h3>
                    <p class="text-secondary mb-0">Track and manage your scheduled consultations, therapy sessions, and clinical follow-ups.</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/Healthcare" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Book New Appointment
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px;">
                <span class="text-muted small">Total Bookings</span>
                <h4 class="fw-bold text-dark mb-0">@Model.Count</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #F6AD55 !important;">
                <span class="text-muted small">Pending Confirmation</span>
                <h4 class="fw-bold text-warning mb-0">@pendingCount</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #48BB78 !important;">
                <span class="text-muted small">Confirmed</span>
                <h4 class="fw-bold text-success mb-0">@confirmedCount</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #4A90D9 !important;">
                <span class="text-muted small">Completed Sessions</span>
                <h4 class="fw-bold text-primary mb-0">@completedCount</h4>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="far fa-calendar-times fa-4x mb-3 text-muted" style="opacity: 0.4;"></i>
                    <h5 class="fw-bold text-secondary">No Appointments Scheduled</h5>
                    <p class="text-muted">You haven't requested any healthcare consultations yet.</p>
                    <a href="/Healthcare" class="btn btn-primary btn-sm">Find a Healthcare Provider</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Doctor / Provider</th>
                                <th>Service / Specialization</th>
                                <th>Date & Time</th>
                                <th>Reason & Notes</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-light text-primary" style="width: 38px; height: 38px;">
                                                <i class="fas fa-user-md"></i>
                                            </div>
                                            <div>
                                                <a href="/Healthcare/Details/@appt.HealthcareProviderId" class="fw-semibold text-dark text-decoration-none">
                                                    @(appt.HealthcareProvider?.Name ?? "Unknown Provider")
                                                </a>
                                                <small class="text-muted d-block">@(appt.HealthcareProvider?.OrganizationOrClinic ?? "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border" style="font-size: 0.75rem;">@(appt.HealthcareProvider?.ProviderType ?? "")</span>
                                        <small class="text-muted d-block">@(appt.HealthcareProvider?.Specialization ?? "")</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark d-block">@appt.AppointmentDate.ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted"><i class="fas fa-clock me-1"></i> @appt.TimeSlot</small>
                                    </td>
                                    <td>
                                        <span class="small d-block text-truncate" style="max-width: 200px;" title="@appt.ReasonForVisit">
                                            <strong>Reason:</strong> @appt.ReasonForVisit
                                        </span>
                                        @if (!string.IsNullOrEmpty(appt.PatientNotes))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 200px;" title="@appt.PatientNotes">
                                                <i class="fas fa-universal-access me-1 text-primary"></i> @appt.PatientNotes
                                            </small>
                                        }
                                        @if (!string.IsNullOrEmpty(appt.DoctorNotes))
                                        {
                                            <small class="text-info d-block text-truncate" style="max-width: 200px;" title="@appt.DoctorNotes">
                                                <i class="fas fa-comment-medical me-1"></i> Doctor: @appt.DoctorNotes
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        @switch (appt.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i> Pending</span>
                                                break;
                                            case "Confirmed":
                                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Confirmed</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-primary"><i class="fas fa-award me-1"></i> Completed</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-secondary"><i class="fas fa-times me-1"></i> Cancelled</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger"><i class="fas fa-ban me-1"></i> Rejected</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark border">@appt.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a href="/Healthcare/Details/@appt.HealthcareProviderId" class="btn btn-outline-primary btn-sm" title="View Provider">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (appt.Status == "Pending" || appt.Status == "Confirmed")
                                            {
                                                <form asp-action="CancelAppointment" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel Appointment">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (appt.Status == "Completed")
                                            {
                                                <a href="/Healthcare/Details/@appt.HealthcareProviderId" class="btn btn-outline-warning btn-sm text-dark" title="Rate / Review Session">
                                                    <i class="fas fa-star text-warning"></i> Review
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

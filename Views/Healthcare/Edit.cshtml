@model SDP1.Models.HealthcareProviderFormViewModel
@{
    ViewData["Title"] = "Edit Healthcare Provider";
    var userRole = Context.Session.GetString("UserRole");
    var isAdmin = userRole == "Admin";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                <div class="p-4" style="background: linear-gradient(135deg, #E8F0FE 0%, #FFFFFF 100%); border-bottom: 1px solid #E2E8F0;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center text-primary rounded-circle"
                             style="width: 50px; height: 50px; background: #FFFFFF; font-size: 1.5rem; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
                            <i class="fas fa-user-edit"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark">Edit Healthcare Provider: @Model.Name</h4>
                            <small class="text-muted">Update clinical details, contact information, and availability schedule.</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="OrganizationId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold small text-secondary">Provider / Center Name *</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ProviderType" class="form-label fw-semibold small text-secondary">Service Type *</label>
                                <select asp-for="ProviderType" class="form-select" required>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Physiotherapist">Physiotherapist</option>
                                    <option value="Speech Therapist">Speech Therapist</option>
                                    <option value="Rehabilitation Center">Rehabilitation Center</option>
                                    <option value="Eye Specialist">Eye Specialist</option>
                                    <option value="Mental Health Specialist">Mental Health Specialist</option>
                                </select>
                                <span asp-validation-for="ProviderType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OrganizationOrClinic" class="form-label fw-semibold small text-secondary">Affiliated Clinic / Hospital *</label>
                                <input asp-for="OrganizationOrClinic" class="form-control" required />
                                <span asp-validation-for="OrganizationOrClinic" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Specialization" class="form-label fw-semibold small text-secondary">Clinical Specialization *</label>
                                <input asp-for="Specialization" class="form-control" required />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small text-secondary">Professional Background & Care Details *</label>
                                <textarea asp-for="Description" rows="4" class="form-control" required></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="AvailableServices" class="form-label fw-semibold small text-secondary">Available Services (Comma separated) *</label>
                                <input asp-for="AvailableServices" class="form-control" required />
                                <span asp-validation-for="AvailableServices" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConsultationFee" class="form-label fw-semibold small text-secondary">Consultation Fee (BDT)</label>
                                <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AvailabilitySchedule" class="form-label fw-semibold small text-secondary">Availability Schedule *</label>
                                <input asp-for="AvailabilitySchedule" class="form-control" required />
                                <span asp-validation-for="AvailabilitySchedule" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold small text-secondary">Contact Phone *</label>
                                <input asp-for="Phone" class="form-control" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email Address *</label>
                                <input asp-for="Email" type="email" class="form-control" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold small text-secondary">Full Street Address *</label>
                                <input asp-for="Address" class="form-control" required />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-semibold small text-secondary">City / Area *</label>
                                <input asp-for="City" class="form-control" required />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="District" class="form-label fw-semibold small text-secondary">District *</label>
                                <input asp-for="District" class="form-control" required />
                                <span asp-validation-for="District" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a href="/Healthcare/Details/@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-1"></i> Update Provider
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model SDP1.Models.HealthcareFilterViewModel
@{
    ViewData["Title"] = "Healthcare & Therapy Finder";
    var userRole = Context.Session.GetString("UserRole");
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #E8F0FE 0%, #FFFFFF 100%); border-left: 5px solid #4A90D9 !important; border-radius: 12px;">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-primary px-3 py-2 mb-2" style="font-size: 0.85rem;"><i class="fas fa-heartbeat me-1"></i> Section 5.5 — Healthcare & Rehabilitation</span>
                    <h2 class="fw-bold mb-1" style="color: #2D3748;">Healthcare & Therapy Finder</h2>
                    <p class="text-secondary mb-0">Discover specialized doctors, physiotherapists, speech therapists, eye specialists, and rehabilitation centers tailored for persons with disabilities.</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="@dashboardUrl" class="btn btn-outline-primary fw-semibold rounded-pill px-3 me-2 mb-2">
                        <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                    @if (userRole == "Disability")
                    {
                        <a href="/Healthcare/MyAppointments" class="btn btn-outline-primary rounded-pill px-3 me-2 mb-2">
                            <i class="fas fa-calendar-check me-1"></i> My Appointments
                        </a>
                    }
                    @if (userRole == "Admin" || userRole == "Organization")
                    {
                        <a href="/Healthcare/ManageAppointments" class="btn btn-outline-secondary rounded-pill px-3 me-2 mb-2">
                            <i class="fas fa-tasks me-1"></i> Manage Requests
                        </a>
                        <a href="/Healthcare/Create" class="btn btn-primary rounded-pill px-3 mb-2">
                            <i class="fas fa-plus me-1"></i> Add Provider
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        <div class="card border-0 shadow-sm p-3" style="border-radius: 12px;">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" name="Keyword" class="form-control border-start-0" placeholder="Search provider name, specialization, clinic, or service..." value="@Model.Keyword" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-map-marker-alt"></i></span>
                        <select name="District" class="form-select border-start-0">
                            <option value="">All Districts</option>
                            @foreach (var district in Model.AvailableDistricts)
                            {
                                if (Model.District == district)
                                {
                                    <option value="@district" selected>@district</option>
                                }
                                else
                                {
                                    <option value="@district">@district</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="SortBy" class="form-select">
                        <option value="newest" selected="@(string.IsNullOrEmpty(Model.SortBy) || Model.SortBy == "newest")">Newly Added</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A-Z)</option>
                        <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z-A)</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter me-1"></i> Search
                    </button>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-lg-3 mb-4">
                <div class="card border-0 shadow-sm p-3" style="border-radius: 12px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0" style="color: #2D3748;"><i class="fas fa-sliders-h me-2 text-primary"></i> Filter Services</h6>
                        <a href="/Healthcare" class="text-decoration-none text-muted small">Reset All</a>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Healthcare Service</label>
                        <div class="list-group list-group-flush">
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "All" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(string.IsNullOrEmpty(Model.ProviderType) || Model.ProviderType == "All" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-th-large me-2"></i> All Services</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Doctor" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Doctor" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-user-md me-2"></i> Doctors</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Physiotherapist" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Physiotherapist" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-walking me-2"></i> Physiotherapists</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Speech Therapist" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Speech Therapist" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-comments me-2"></i> Speech Therapists</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Rehabilitation Center" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Rehabilitation Center" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-hospital me-2"></i> Rehab Centers</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Eye Specialist" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Eye Specialist" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-eye me-2"></i> Eye Specialists</span>
                            </a>
                            <a href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, SortBy = Model.SortBy, ProviderType = "Mental Health Specialist" })"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-2 py-2 rounded mb-1 @(Model.ProviderType == "Mental Health Specialist" ? "active bg-primary text-white" : "text-secondary")">
                                <span><i class="fas fa-brain me-2"></i> Mental Health</span>
                            </a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">City / Area</label>
                        <input type="text" name="City" class="form-control form-control-sm" placeholder="e.g. Mirpur, Agrabad" value="@Model.City" />
                    </div>

                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Apply Filters</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small">Showing <strong>@Model.Providers.Count</strong> of <strong>@Model.TotalCount</strong> providers</span>
                </div>

                @if (!Model.Providers.Any())
                {
                    <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 12px;">
                        <div class="card-body">
                            <i class="fas fa-user-md-slash fa-4x text-muted mb-3" style="opacity: 0.5;"></i>
                            <h5 class="fw-bold text-secondary">No Healthcare Providers Found</h5>
                            <p class="text-muted">We couldn't find any healthcare professionals or rehabilitation centers matching your current filters.</p>
                            <a href="/Healthcare" class="btn btn-primary btn-sm">Clear All Filters</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var provider in Model.Providers)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm provider-card" style="border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s;">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex align-items-start mb-3">
                                            <div class="provider-avatar-circle me-3 flex-shrink-0 d-flex align-items-center justify-content-center text-primary"
                                                 style="width: 52px; height: 52px; border-radius: 50%; background: #E8F0FE; font-size: 1.4rem;">
                                                @switch (provider.ProviderType)
                                                {
                                                    case "Doctor":
                                                        <i class="fas fa-user-md"></i>
                                                        break;
                                                    case "Physiotherapist":
                                                        <i class="fas fa-walking"></i>
                                                        break;
                                                    case "Speech Therapist":
                                                        <i class="fas fa-comments"></i>
                                                        break;
                                                    case "Rehabilitation Center":
                                                        <i class="fas fa-hospital"></i>
                                                        break;
                                                    case "Eye Specialist":
                                                        <i class="fas fa-eye"></i>
                                                        break;
                                                    case "Mental Health Specialist":
                                                        <i class="fas fa-brain"></i>
                                                        break;
                                                    default:
                                                        <i class="fas fa-stethoscope"></i>
                                                        break;
                                                }
                                            </div>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="d-flex align-items-center gap-1 mb-1">
                                                    <span class="badge bg-light text-primary border" style="font-size: 0.75rem;">@provider.ProviderType</span>
                                                </div>
                                                <h6 class="fw-bold mb-0 text-truncate text-dark" title="@provider.Name">@provider.Name</h6>
                                                <small class="text-muted d-block text-truncate" title="@provider.OrganizationOrClinic">@provider.OrganizationOrClinic</small>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <span class="badge" style="background-color: #F0F4F8; color: #334E68; font-weight: 500; font-size: 0.8rem;">
                                                <i class="fas fa-certificate text-primary me-1"></i> @provider.Specialization
                                            </span>
                                        </div>

                                        <div class="small text-muted mb-3 flex-grow-1">
                                            <div class="mb-1 text-truncate" title="@provider.Address">
                                                <i class="fas fa-map-marker-alt text-danger me-1"></i> @provider.City, @provider.District
                                            </div>
                                            <div class="mb-1">
                                                <i class="fas fa-clock text-info me-1"></i> @provider.AvailabilitySchedule
                                            </div>
                                            <div>
                                                <i class="fas fa-money-bill-wave text-success me-1"></i>
                                                @if (provider.ConsultationFee.HasValue && provider.ConsultationFee.Value > 0)
                                                {
                                                    <span class="fw-semibold text-dark">BDT @provider.ConsultationFee.Value.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Free / Subsidized</span>
                                                }
                                            </div>
                                        </div>

                                        @if (provider.ServicesList.Any())
                                        {
                                            <div class="mb-3">
                                                @foreach (var s in provider.ServicesList.Take(3))
                                                {
                                                    <span class="badge bg-light text-secondary border me-1 mb-1" style="font-size: 0.72rem;">@s</span>
                                                }
                                                @if (provider.ServicesList.Count > 3)
                                                {
                                                    <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">+@(provider.ServicesList.Count - 3) more</span>
                                                }
                                            </div>
                                        }

                                        <div class="pt-3 border-top d-flex gap-2">
                                            <a href="/Healthcare/Details/@provider.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                                <i class="fas fa-info-circle me-1"></i> View Profile
                                            </a>
                                            <a href="/Healthcare/BookAppointment/@provider.Id" class="btn btn-primary btn-sm flex-fill">
                                                <i class="fas fa-calendar-plus me-1"></i> Book
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-5" aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, ProviderType = Model.ProviderType, City = Model.City, SortBy = Model.SortBy, Page = Model.Page - 1 })">Previous</a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.Page ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, ProviderType = Model.ProviderType, City = Model.City, SortBy = Model.SortBy, Page = p })">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { Keyword = Model.Keyword, District = Model.District, ProviderType = Model.ProviderType, City = Model.City, SortBy = Model.SortBy, Page = Model.Page + 1 })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .provider-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(74, 144, 217, 0.15) !important;
        }
    </style>
}

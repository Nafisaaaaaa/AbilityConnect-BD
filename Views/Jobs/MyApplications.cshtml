@model List<SDP1.Models.JobApplication>
@{
    ViewData["Title"] = "My Job Applications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-file-alt text-primary me-2"></i>My Job Applications</h2>
            <p class="text-muted mb-0">Track and manage your submitted applications and hiring status.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/Disability/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <a href="/Jobs" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-search me-1"></i> Browse More Jobs
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5 bg-white">
            <div class="card-body">
                <div class="mb-3 text-muted" style="font-size: 3.5rem;">
                    <i class="fas fa-inbox"></i>
                </div>
                <h4 class="fw-bold text-dark">No Applications Yet</h4>
                <p class="text-muted max-w-md mx-auto">
                    You haven't submitted any job applications yet. Discover opportunities matching your skills and accessibility needs.
                </p>
                <a href="/Jobs" class="btn btn-primary mt-2">
                    <i class="fas fa-briefcase me-1"></i> Explore Accessible Jobs
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Job Title & Employer</th>
                            <th scope="col">Workplace / Location</th>
                            <th scope="col">Applied Date</th>
                            <th scope="col">Submitted Resume</th>
                            <th scope="col">Current Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            var statusBadge = app.Status switch
                            {
                                "Accepted" => "bg-success text-white",
                                "Shortlisted" => "bg-primary text-white",
                                "Reviewed" => "bg-info text-dark",
                                "Rejected" => "bg-danger text-white",
                                _ => "bg-warning text-dark"
                            };

                            var statusIcon = app.Status switch
                            {
                                "Accepted" => "fa-check-circle",
                                "Shortlisted" => "fa-star",
                                "Reviewed" => "fa-eye",
                                "Rejected" => "fa-times-circle",
                                _ => "fa-hourglass-half"
                            };

                            <tr>
                                <td class="ps-4 py-3">
                                    <h6 class="fw-bold mb-1">
                                        <a href="/Jobs/Details/@app.JobId" class="text-dark text-decoration-none hover-primary">
                                            @(app.Job?.Title ?? "Job Posting")
                                        </a>
                                    </h6>
                                    <span class="text-primary small">
                                        <i class="fas fa-building me-1"></i>@(app.Job?.Organization?.OrganizationName ?? "Organization")
                                    </span>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@(app.Job?.WorkplaceType ?? "Onsite")</div>
                                    <div class="text-muted small">@(app.Job?.Location ?? "N/A")</div>
                                </td>
                                <td class="text-muted small">
                                    @app.AppliedAt.ToString("MMM dd, yyyy")
                                    <div class="text-xs text-muted">@app.AppliedAt.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <a href="@app.ResumePath" target="_blank" class="btn btn-sm btn-light border text-primary">
                                        <i class="fas fa-file-pdf me-1 text-danger"></i> View Resume
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-3 py-2">
                                        <i class="fas @statusIcon me-1"></i>@app.Status
                                    </span>
                                    @if (!string.IsNullOrEmpty(app.OrganizationNotes))
                                    {
                                        <div class="small text-muted mt-1" title="Note from Employer">
                                            <i class="fas fa-comment-dots text-info me-1"></i>@app.OrganizationNotes
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Jobs/Details/@app.JobId" class="btn btn-sm btn-outline-primary">
                                        View Job
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
        }
    </script>
}

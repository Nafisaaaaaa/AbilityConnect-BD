@model SDP1.Models.JobListViewModel
@{
    ViewData["Title"] = "Accessible Job Portal";
    var userRole = Context.Session.GetString("UserRole");
    var isDisability = userRole == "Disability";
    var isOrg = userRole == "Organization";
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-briefcase text-primary me-2"></i>Accessible Job Portal</h2>
            <p class="text-muted mb-0">Discover inclusive career opportunities tailored with accessibility features and flexible workplace options.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@dashboardUrl" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            @if (isDisability)
            {
                <a href="/Jobs/SavedJobs" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="fas fa-bookmark me-1"></i> Saved Jobs (@Model.SavedJobIds.Count)
                </a>
                <a href="/Jobs/MyApplications" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="fas fa-file-alt me-1"></i> My Applications
                </a>
            }
            else if (isOrg)
            {
                <a href="/Jobs/Manage" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="fas fa-tasks me-1"></i> Manage My Jobs
                </a>
                <a href="/Jobs/Create" class="btn btn-primary rounded-pill px-3">
                    <i class="fas fa-plus-circle me-1"></i> Post a Job
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" id="searchForm">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-search"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Job title, skills, organization..." value="@Model.SearchKeyword" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-map-marker-alt"></i></span>
                            <input type="text" name="location" class="form-control border-start-0" placeholder="Location or city..." value="@Model.Location" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="sortOrder" class="form-select" onchange="document.getElementById('searchForm').submit();">
                            <option value="newest" selected="@(Model.SortOrder == "newest")">Newest First</option>
                            <option value="oldest" selected="@(Model.SortOrder == "oldest")">Oldest First</option>
                            <option value="deadline" selected="@(Model.SortOrder == "deadline")">Deadline (Earliest)</option>
                            <option value="title" selected="@(Model.SortOrder == "title")">Title (A-Z)</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Search</button>
                        <a href="/Jobs" class="btn btn-light border" title="Reset Filters"><i class="fas fa-redo"></i></a>
                    </div>
                </div>

                <input type="hidden" name="jobType" value="@Model.JobType" id="hiddenJobType" />
                <input type="hidden" name="workplaceType" value="@Model.WorkplaceType" id="hiddenWorkplaceType" />
                <input type="hidden" name="accessibility" value="@Model.AccessibilityFeature" id="hiddenAccessibility" />
                @if (Model.FlexibleHoursOnly.HasValue && Model.FlexibleHoursOnly.Value)
                {
                    <input type="hidden" name="flexibleHours" value="true" />
                }
                @if (Model.AssistiveTechOnly.HasValue && Model.AssistiveTechOnly.Value)
                {
                    <input type="hidden" name="assistiveTech" value="true" />
                }
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-sliders-h text-primary me-2"></i>Filter Opportunities</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Workplace Option</label>
                        <div class="d-flex flex-column gap-1">
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, jobType = Model.JobType, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(string.IsNullOrEmpty(Model.WorkplaceType) ? "btn-primary text-white" : "btn-light")">
                                All Workplace Types
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = "Remote", jobType = Model.JobType, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.WorkplaceType == "Remote" ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-laptop-house text-success me-1"></i> Remote
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = "Hybrid", jobType = Model.JobType, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.WorkplaceType == "Hybrid" ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-building-user text-info me-1"></i> Hybrid
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = "Onsite", jobType = Model.JobType, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.WorkplaceType == "Onsite" ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-building text-secondary me-1"></i> Onsite
                            </a>
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Job Type</label>
                        <div class="d-flex flex-column gap-1">
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(string.IsNullOrEmpty(Model.JobType) ? "btn-primary text-white" : "btn-light")">
                                All Job Types
                            </a>
                            @foreach (var type in Model.AvailableJobTypes)
                            {
                                <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, jobType = type, accessibility = Model.AccessibilityFeature, sortOrder = Model.SortOrder })"
                                   class="btn btn-sm text-start @(Model.JobType == type ? "btn-primary text-white" : "btn-light")">
                                    @type
                                </a>
                            }
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Accessibility Perks</label>
                        <div class="d-flex flex-column gap-2">
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, jobType = Model.JobType, accessibility = "Wheelchair", sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.AccessibilityFeature == "Wheelchair" ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-wheelchair text-primary me-1"></i> Wheelchair Accessible
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, jobType = Model.JobType, accessibility = "Screen Reader", sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.AccessibilityFeature == "Screen Reader" ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-desktop text-info me-1"></i> Screen Reader Compatible
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, jobType = Model.JobType, flexibleHours = !(Model.FlexibleHoursOnly ?? false), sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.FlexibleHoursOnly == true ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-clock text-warning me-1"></i> Flexible Hours Only
                            </a>
                            <a href="@Url.Action("Index", new { search = Model.SearchKeyword, location = Model.Location, workplaceType = Model.WorkplaceType, jobType = Model.JobType, assistiveTech = !(Model.AssistiveTechOnly ?? false), sortOrder = Model.SortOrder })"
                               class="btn btn-sm text-start @(Model.AssistiveTechOnly == true ? "btn-primary text-white" : "btn-light")">
                                <i class="fas fa-hands-helping text-success me-1"></i> Assistive Tech Support
                            </a>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.JobType) || !string.IsNullOrEmpty(Model.WorkplaceType) || !string.IsNullOrEmpty(Model.AccessibilityFeature) || Model.FlexibleHoursOnly == true || Model.AssistiveTechOnly == true || !string.IsNullOrEmpty(Model.SearchKeyword))
                    {
                        <div class="d-grid mt-3">
                            <a href="/Jobs" class="btn btn-sm btn-outline-danger"><i class="fas fa-times-circle me-1"></i> Reset All Filters</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">Showing <strong>@Model.Jobs.Count</strong> of <strong>@Model.TotalJobs</strong> job opportunities</span>
                @if (isOrg)
                {
                    <span class="badge bg-primary px-3 py-2"><i class="fas fa-building me-1"></i> Organization View</span>
                }
            </div>

            @if (!Model.Jobs.Any())
            {
                <div class="card shadow-sm border-0 text-center py-5 bg-white">
                    <div class="card-body">
                        <div class="mb-3 text-muted" style="font-size: 3.5rem;">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <h4 class="fw-bold text-dark">No Jobs Found</h4>
                        <p class="text-muted max-w-md mx-auto">
                            No job opportunities matched your current search and filter criteria. Try adjusting your search keywords or resetting filters.
                        </p>
                        <a href="/Jobs" class="btn btn-primary mt-2">
                            <i class="fas fa-redo me-1"></i> View All Available Jobs
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var job in Model.Jobs)
                    {
                        var isSaved = Model.SavedJobIds.Contains(job.Id);
                        var hasApplied = Model.AppliedJobIds.Contains(job.Id);
                        var status = hasApplied && Model.ApplicationStatuses.ContainsKey(job.Id) ? Model.ApplicationStatuses[job.Id] : "";

                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 shadow-sm border-0 job-card position-relative" style="transition: transform 0.2s, box-shadow 0.2s;">
                                <div class="card-body d-flex flex-column p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        @{
                                            var badgeClass = job.WorkplaceType switch
                                            {
                                                "Remote" => "bg-success",
                                                "Hybrid" => "bg-info text-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass"><i class="fas fa-map-marker-alt me-1"></i>@job.WorkplaceType</span>

                                        @if (isDisability)
                                        {
                                            <form method="post" asp-action="ToggleSave" asp-route-id="@job.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" title="@(isSaved ? "Remove from saved" : "Save this job")">
                                                    <i class="@(isSaved ? "fas fa-bookmark text-primary" : "far fa-bookmark text-muted") fa-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>

                                    <h5 class="card-title fw-bold mb-1">
                                        <a href="/Jobs/Details/@job.Id" class="text-dark text-decoration-none hover-primary">@job.Title</a>
                                    </h5>
                                    <div class="text-primary small fw-semibold mb-2">
                                        <i class="fas fa-building me-1"></i>@(job.Organization?.OrganizationName ?? "Verified Employer")
                                    </div>

                                    <div class="text-muted small mb-2">
                                        <i class="fas fa-map-pin me-1 text-danger"></i>@job.Location
                                        <span class="mx-1">•</span>
                                        <span class="badge bg-light text-dark border">@job.JobType</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(job.Salary))
                                    {
                                        <div class="fw-bold text-success small mb-2">
                                            <i class="fas fa-money-bill-wave me-1"></i>@job.Salary
                                        </div>
                                    }

                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @if (!string.IsNullOrEmpty(job.AccessibilityFeatures))
                                        {
                                            @foreach (var feature in job.AccessibilityFeatures.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2))
                                            {
                                                <span class="badge bg-light text-primary border" style="font-size: 0.72rem;">
                                                    <i class="fas fa-check-circle me-1"></i>@feature
                                                </span>
                                            }
                                        }
                                        @if (job.FlexibleWorkingHours)
                                        {
                                            <span class="badge bg-light text-warning border" style="font-size: 0.72rem;">
                                                <i class="fas fa-clock me-1"></i>Flexible Hours
                                            </span>
                                        }
                                        @if (job.AssistiveTechnologySupport)
                                        {
                                            <span class="badge bg-light text-info border" style="font-size: 0.72rem;">
                                                <i class="fas fa-universal-access me-1"></i>Assistive Tech
                                            </span>
                                        }
                                    </div>

                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <div class="text-muted small" title="Application Deadline">
                                            <i class="far fa-calendar-alt text-danger me-1"></i>@job.ApplicationDeadline.ToString("MMM dd, yyyy")
                                        </div>

                                        <div>
                                            @if (hasApplied)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1 small">
                                                    <i class="fas fa-check-circle me-1"></i>Applied (@status)
                                                </span>
                                            }
                                            else
                                            {
                                                <a href="/Jobs/Details/@job.Id" class="btn btn-sm btn-primary">
                                                    View Details
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4 d-flex justify-content-center" aria-label="Job page navigation">
                        <ul class="pagination pagination-md mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchKeyword, location = Model.Location, jobType = Model.JobType, workplaceType = Model.WorkplaceType, accessibility = Model.AccessibilityFeature, flexibleHours = Model.FlexibleHoursOnly, assistiveTech = Model.AssistiveTechOnly, sortOrder = Model.SortOrder })">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = p, search = Model.SearchKeyword, location = Model.Location, jobType = Model.JobType, workplaceType = Model.WorkplaceType, accessibility = Model.AccessibilityFeature, flexibleHours = Model.FlexibleHoursOnly, assistiveTech = Model.AssistiveTechOnly, sortOrder = Model.SortOrder })">
                                        @p
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchKeyword, location = Model.Location, jobType = Model.JobType, workplaceType = Model.WorkplaceType, accessibility = Model.AccessibilityFeature, flexibleHours = Model.FlexibleHoursOnly, assistiveTech = Model.AssistiveTechOnly, sortOrder = Model.SortOrder })">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');</text>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["InfoMessage"])', 'info');</text>
        }
    </script>
}

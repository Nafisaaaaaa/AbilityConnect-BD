@model List<SDP1.Models.JobApplication>
@{
    ViewData["Title"] = "Review Applications";
    var currentFilter = ViewBag.StatusFilter as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-users text-primary me-2"></i>Review Candidate Applications</h2>
            <p class="text-muted mb-0">Review, evaluate, and manage candidate submissions across all your posted jobs.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Organization/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <a href="/Jobs/Manage" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-tasks me-1"></i> Manage Jobs
            </a>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3 flex-wrap">
        <a href="/Jobs/ReviewApplications" class="btn btn-sm @(string.IsNullOrEmpty(currentFilter) ? "btn-primary" : "btn-light border")">
            All Applications (@Model.Count)
        </a>
        <a href="/Jobs/ReviewApplications?statusFilter=Pending" class="btn btn-sm @(currentFilter == "Pending" ? "btn-primary fw-semibold" : "btn-light border")">
            Pending
        </a>
        <a href="/Jobs/ReviewApplications?statusFilter=Reviewed" class="btn btn-sm @(currentFilter == "Reviewed" ? "btn-info text-dark" : "btn-light border")">
            Reviewed
        </a>
        <a href="/Jobs/ReviewApplications?statusFilter=Shortlisted" class="btn btn-sm @(currentFilter == "Shortlisted" ? "btn-primary" : "btn-light border")">
            Shortlisted
        </a>
        <a href="/Jobs/ReviewApplications?statusFilter=Accepted" class="btn btn-sm @(currentFilter == "Accepted" ? "btn-success" : "btn-light border")">
            Accepted
        </a>
        <a href="/Jobs/ReviewApplications?statusFilter=Rejected" class="btn btn-sm @(currentFilter == "Rejected" ? "btn-danger" : "btn-light border")">
            Rejected
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5 bg-white">
            <div class="card-body">
                <div class="mb-3 text-muted" style="font-size: 3.5rem;">
                    <i class="fas fa-inbox"></i>
                </div>
                <h4 class="fw-bold text-dark">No Applications Found</h4>
                <p class="text-muted max-w-md mx-auto">
                    @if (!string.IsNullOrEmpty(currentFilter))
                    {
                        <span>No candidate applications currently match the status filter '<strong>@currentFilter</strong>'.</span>
                    }
                    else
                    {
                        <span>No candidate applications have been received yet for your active job posts.</span>
                    }
                </p>
                <a href="/Jobs/Manage" class="btn btn-primary mt-2">
                    <i class="fas fa-tasks me-1"></i> View My Job Postings
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Applicant</th>
                            <th scope="col">Job Position</th>
                            <th scope="col">Disability Profile</th>
                            <th scope="col">Applied Date</th>
                            <th scope="col">Resume</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            var statusBadge = app.Status switch
                            {
                                "Accepted" => "bg-success text-white",
                                "Shortlisted" => "bg-primary text-white",
                                "Reviewed" => "bg-info text-dark",
                                "Rejected" => "bg-danger text-white",
                                _ => "bg-warning text-dark"
                            };

                            <tr>
                                <td class="ps-4 py-3">
                                    <h6 class="fw-bold mb-0">@app.ApplicantFullName</h6>
                                    <div class="small text-muted"><i class="fas fa-envelope me-1"></i>@app.ApplicantEmail</div>
                                    <div class="small text-muted"><i class="fas fa-phone me-1"></i>@app.ApplicantPhone</div>
                                </td>
                                <td>
                                    <h6 class="fw-bold mb-1">
                                        <a href="/Jobs/Details/@app.JobId" class="text-dark text-decoration-none hover-primary">
                                            @(app.Job?.Title ?? "Job Posting")
                                        </a>
                                    </h6>
                                    <span class="badge bg-light text-dark border">@(app.Job?.WorkplaceType ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fas fa-universal-access me-1 text-primary"></i>
                                        @(app.DisabilityUser?.DisabilityType ?? "Disability User")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @app.AppliedAt.ToString("MMM dd, yyyy")
                                    <div class="text-xs">@app.AppliedAt.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <a href="@app.ResumePath" target="_blank" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-file-pdf me-1"></i> Resume
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-2 py-1">@app.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Jobs/Applicants/@app.JobId" class="btn btn-sm btn-primary">
                                        <i class="fas fa-sliders-h me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');</text>
        }
    </script>
}

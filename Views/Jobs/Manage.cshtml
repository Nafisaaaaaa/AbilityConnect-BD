@model SDP1.Models.OrgJobManageViewModel
@{
    ViewData["Title"] = "Manage Job Postings";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-tasks text-primary me-2"></i>Job Postings Management</h2>
            <p class="text-muted mb-0">Create, monitor, and manage disability-inclusive employment opportunities.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Organization/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <a href="/Jobs/Create" class="btn btn-primary rounded-pill px-3">
                <i class="fas fa-plus-circle me-1"></i> Post New Job
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 me-3">
                        <i class="fas fa-briefcase fa-2x"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Total Postings</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalJobs</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-success-subtle text-success rounded-3 me-3">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Active Jobs</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.ActiveJobs</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-info-subtle text-info rounded-3 me-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Total Applicants</span>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalApplicants</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Jobs.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5 bg-white">
            <div class="card-body">
                <div class="mb-3 text-muted" style="font-size: 3.5rem;">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h4 class="fw-bold text-dark">No Job Postings Yet</h4>
                <p class="text-muted max-w-md mx-auto">
                    You haven't posted any job opportunities yet. Click the button below to publish your first disability-friendly job!
                </p>
                <a href="/Jobs/Create" class="btn btn-primary mt-2">
                    <i class="fas fa-plus-circle me-1"></i> Post Your First Job
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Job Title & Details</th>
                            <th scope="col">Workplace / Type</th>
                            <th scope="col">Deadline</th>
                            <th scope="col">Status</th>
                            <th scope="col">Applications</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Jobs)
                        {
                            var job = item.Job;
                            <tr>
                                <td class="ps-4 py-3">
                                    <h6 class="fw-bold mb-1">
                                        <a href="/Jobs/Details/@job.Id" class="text-dark text-decoration-none hover-primary">@job.Title</a>
                                    </h6>
                                    <div class="text-muted small">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i>@job.Location
                                        <span class="mx-1">•</span>
                                        <span class="text-success fw-semibold">@(string.IsNullOrEmpty(job.Salary) ? "Negotiable" : job.Salary)</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@job.WorkplaceType</span>
                                    <div class="small text-muted mt-1">@job.JobType</div>
                                </td>
                                <td>
                                    @{
                                        var isExpired = job.ApplicationDeadline.Date < DateTime.UtcNow.Date;
                                    }
                                    <div class="small @(isExpired ? "text-danger fw-bold" : "text-muted")">
                                        @job.ApplicationDeadline.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger text-white" style="font-size: 0.65rem;">Expired</span>
                                    }
                                </td>
                                <td>
                                    @if (job.JobStatus == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">@job.JobStatus</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Jobs/Applicants/@job.Id" class="btn btn-sm btn-outline-info position-relative">
                                        <i class="fas fa-users me-1"></i> @item.ApplicationCount Candidates
                                        @if (item.PendingCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">@item.PendingCount new</span>
                                        }
                                    </a>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="/Jobs/Details/@job.Id" class="btn btn-sm btn-light border" title="View Public Posting">
                                            <i class="fas fa-eye text-muted"></i>
                                        </a>

                                        @if (Context.Session.GetString("UserRole") != "Admin")
                                        {
                                            <a href="/Jobs/Edit/@job.Id" class="btn btn-sm btn-light border" title="Edit Posting">
                                                <i class="fas fa-edit text-primary"></i>
                                            </a>
                                        }

                                        <form method="post" asp-action="ToggleStatus" asp-route-id="@job.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border" title="@(job.JobStatus == "Active" ? "Close Job" : "Activate Job")">
                                                <i class="fas @(job.JobStatus == "Active" ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                            </button>
                                        </form>

                                        <a href="/Jobs/Delete/@job.Id" class="btn btn-sm btn-light border" title="Delete Posting">
                                            <i class="fas fa-trash-alt text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');</text>
        }
    </script>
}

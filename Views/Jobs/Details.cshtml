@model SDP1.Models.JobDetailsViewModel
@{
    ViewData["Title"] = Model.Job.Title + " - Job Details";
    var userRole = Context.Session.GetString("UserRole");
    var isDisability = userRole == "Disability";
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="/Jobs" class="text-decoration-none">Jobs</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Job.Title</li>
            </ol>
        </nav>
        <a href="@dashboardUrl" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
            <i class="fas fa-home me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                @{
                                    var workplaceClass = Model.Job.WorkplaceType switch
                                    {
                                        "Remote" => "bg-success",
                                        "Hybrid" => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @workplaceClass px-2 py-1">@Model.Job.WorkplaceType</span>
                                <span class="badge bg-light text-dark border px-2 py-1">@Model.Job.JobType</span>
                                @if (Model.Job.JobStatus == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="fas fa-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">@Model.Job.JobStatus</span>
                                }
                            </div>
                            <h2 class="fw-bold text-dark mb-1">@Model.Job.Title</h2>
                            <h5 class="text-primary mb-0">
                                <i class="fas fa-building me-1"></i>@(Model.Job.Organization?.OrganizationName ?? "Verified Employer")
                            </h5>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            @if (isDisability)
                            {
                                <form method="post" asp-action="ToggleSave" asp-route-id="@Model.Job.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn @(Model.IsSaved ? "btn-primary" : "btn-outline-primary")">
                                        <i class="fas fa-bookmark me-1"></i>@(Model.IsSaved ? "Saved" : "Save Job")
                                    </button>
                                </form>
                            }
                            @if (Model.IsOwner || Model.IsAdmin)
                            {
                                <a href="/Jobs/Applicants/@Model.Job.Id" class="btn btn-outline-success">
                                    <i class="fas fa-users me-1"></i> Applicants
                                </a>
                                <a href="/Jobs/Edit/@Model.Job.Id" class="btn btn-outline-primary">
                                    <i class="fas fa-edit me-1"></i> Edit
                                </a>
                            }
                        </div>
                    </div>

                    <div class="row g-3 py-3 border-top border-bottom bg-light rounded-3 px-2 mb-3">
                        <div class="col-sm-6 col-md-3">
                            <span class="text-muted small d-block"><i class="fas fa-map-marker-alt text-danger me-1"></i>Location</span>
                            <span class="fw-semibold text-dark">@Model.Job.Location</span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-muted small d-block"><i class="fas fa-money-bill-wave text-success me-1"></i>Salary</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Job.Salary) ? "Negotiable" : Model.Job.Salary)</span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-muted small d-block"><i class="fas fa-users text-primary me-1"></i>Vacancies</span>
                            <span class="fw-semibold text-dark">@Model.Job.VacancyCount Position(s)</span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-muted small d-block"><i class="far fa-calendar-alt text-warning me-1"></i>Deadline</span>
                            <span class="fw-semibold text-danger">@Model.Job.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    @if (Model.HasApplied && Model.Application != null)
                    {
                        var statusBadge = Model.Application.Status switch
                        {
                            "Accepted" => "bg-success",
                            "Shortlisted" => "bg-primary",
                            "Reviewed" => "bg-info text-dark",
                            "Rejected" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <div class="alert alert-info border-0 d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="fas fa-info-circle me-1"></i> You have applied for this job</h6>
                                <p class="mb-0 small text-muted">Applied on @Model.Application.AppliedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                            </div>
                            <div class="text-end">
                                <span class="badge @statusBadge px-3 py-2 fs-6">Status: @Model.Application.Status</span>
                                <a href="/Jobs/MyApplications" class="btn btn-sm btn-link text-decoration-none d-block mt-1">View Application</a>
                            </div>
                        </div>
                    }

                    <div class="card border-primary border-opacity-25 bg-light mb-4">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="fas fa-universal-access me-2"></i>Accessibility & Inclusivity Highlights
                            </h6>
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(Model.Job.AccessibilityFeatures))
                                {
                                    @foreach (var feature in Model.Job.AccessibilityFeatures.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fas fa-check-circle text-success"></i>
                                                <span class="text-dark small">@feature</span>
                                            </div>
                                        </div>
                                    }
                                }
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @(Model.Job.FlexibleWorkingHours ? "fa-check-circle text-success" : "fa-times-circle text-muted")"></i>
                                        <span class="text-dark small">Flexible Working Hours: @(Model.Job.FlexibleWorkingHours ? "Available" : "Standard hours")</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @(Model.Job.AssistiveTechnologySupport ? "fa-check-circle text-success" : "fa-times-circle text-muted")"></i>
                                        <span class="text-dark small">Assistive Technology Support: @(Model.Job.AssistiveTechnologySupport ? "Provided" : "Self-equipped")</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Job.AssistiveTechDetails))
                                {
                                    <div class="col-12 mt-2">
                                        <div class="p-2 bg-white rounded border small text-muted">
                                            <strong>Tech Details:</strong> @Model.Job.AssistiveTechDetails
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Job Description</h5>
                        <div class="text-secondary" style="white-space: pre-line; line-height: 1.8;">
                            @Model.Job.Description
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Required Skills</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Job.RequiredSkills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">
                                    <i class="fas fa-code me-1"></i>@skill
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Education & Experience</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Education Requirement:</span>
                                <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Job.EducationRequirement) ? "Not Specified" : Model.Job.EducationRequirement)</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Experience Level:</span>
                                <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Job.ExperienceLevel) ? "Not Specified" : Model.Job.ExperienceLevel)</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-light rounded-3 text-center border mt-4">
                        @if (isDisability)
                        {
                            @if (Model.HasApplied)
                            {
                                <button class="btn btn-secondary btn-lg px-4" disabled>
                                    <i class="fas fa-check-circle me-1"></i> Already Applied
                                </button>
                                <a href="/Jobs/MyApplications" class="btn btn-outline-primary btn-lg ms-2">
                                    View in Applications Tracker
                                </a>
                            }
                            else if (Model.Job.ApplicationDeadline.Date < DateTime.UtcNow.Date)
                            {
                                <button class="btn btn-danger btn-lg px-4" disabled>
                                    <i class="fas fa-times-circle me-1"></i> Deadline Expired
                                </button>
                            }
                            else if (Model.Job.JobStatus != "Active" || !Model.Job.IsPublished)
                            {
                                <button class="btn btn-secondary btn-lg px-4" disabled>
                                    <i class="fas fa-lock me-1"></i> Position Closed
                                </button>
                            }
                            else
                            {
                                <a href="/Jobs/Apply/@Model.Job.Id" class="btn btn-primary btn-lg px-5">
                                    <i class="fas fa-paper-plane me-2"></i> Apply for this Job
                                </a>
                            }
                        }
                        else if (Model.IsOwner)
                        {
                            <div class="d-flex justify-content-center gap-3">
                                <a href="/Jobs/Applicants/@Model.Job.Id" class="btn btn-primary btn-lg px-4">
                                    <i class="fas fa-users me-2"></i> Review Applicants
                                </a>
                                <a href="/Jobs/Edit/@Model.Job.Id" class="btn btn-outline-primary btn-lg px-4">
                                    <i class="fas fa-edit me-2"></i> Edit Posting
                                </a>
                            </div>
                        }
                        else if (Model.IsAdmin)
                        {
                            <div class="d-flex justify-content-center gap-3">
                                <a href="/Jobs/Applicants/@Model.Job.Id" class="btn btn-primary btn-lg px-4">
                                    <i class="fas fa-users me-2"></i> Review Applicants
                                </a>
                                <a href="/Jobs/Delete/@Model.Job.Id" class="btn btn-outline-danger btn-lg px-4">
                                    <i class="fas fa-trash-alt me-2"></i> Delete Job
                                </a>
                            </div>
                        }
                        else
                        {
                            <h5 class="fw-bold mb-2">Interested in this opportunity?</h5>
                            <p class="text-muted small mb-3">Please log in with your Person with Disability account to submit your application.</p>
                            <a href="/Account/Login" class="btn btn-primary btn-lg px-4">
                                <i class="fas fa-sign-in-alt me-2"></i> Login to Apply
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-building text-primary me-2"></i>About the Organization</h6>
                </div>
                <div class="card-body p-3">
                    <h5 class="fw-bold text-dark mb-1">@(Model.Job.Organization?.OrganizationName ?? "Verified Employer")</h5>
                    <span class="badge bg-success-subtle text-success border border-success mb-3">
                        <i class="fas fa-check-circle me-1"></i>Verified Organization
                    </span>

                    <p class="text-muted small mb-3">
                        @(Model.Job.Organization?.OrganizationDescription ?? "An inclusive organization committed to equal opportunity and accessible workplaces.")
                    </p>

                    <div class="d-flex flex-column gap-2 small">
                        <div>
                            <i class="fas fa-tag text-muted me-2"></i>
                            <strong>Type:</strong> @(Model.Job.Organization?.OrganizationType ?? "Enterprise")
                        </div>
                        <div>
                            <i class="fas fa-map-marker-alt text-muted me-2"></i>
                            <strong>City:</strong> @(Model.Job.Organization?.City ?? "Bangladesh")
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Job.Organization?.Website))
                        {
                            <div>
                                <i class="fas fa-globe text-muted me-2"></i>
                                <strong>Website:</strong> <a href="@Model.Job.Organization.Website" target="_blank" rel="noopener">Visit Website</a>
                            </div>
                        }
                        <div>
                            <i class="fas fa-user text-muted me-2"></i>
                            <strong>Contact:</strong> @(Model.Job.Organization?.ContactPersonName ?? "HR Department")
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle text-primary me-2"></i>Job Overview</h6>
                </div>
                <div class="card-body p-3 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Posted On:</span>
                        <span class="fw-semibold">@Model.Job.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Application Deadline:</span>
                        <span class="fw-semibold text-danger">@Model.Job.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Workplace:</span>
                        <span class="fw-semibold">@Model.Job.WorkplaceType</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Employment Type:</span>
                        <span class="fw-semibold">@Model.Job.JobType</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Positions:</span>
                        <span class="fw-semibold">@Model.Job.VacancyCount</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Salary:</span>
                        <span class="fw-semibold text-success">@(string.IsNullOrEmpty(Model.Job.Salary) ? "Negotiable" : Model.Job.Salary)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');</text>
        }
    </script>
}

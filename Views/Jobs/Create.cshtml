@model SDP1.Models.JobCreateViewModel
@{
    ViewData["Title"] = "Post New Accessible Job";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="/Jobs/Manage" class="text-decoration-none">Manage Jobs</a></li>
                <li class="breadcrumb-item active" aria-current="page">Post New Job</li>
            </ol>
        </nav>
        <a href="/Organization/Dashboard" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
            <i class="fas fa-home me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="fw-bold mb-1"><i class="fas fa-plus-circle me-2"></i>Post New Accessible Job</h4>
                    <p class="mb-0 opacity-90">Publish an inclusive employment opportunity with detailed accessibility and accommodation info.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createJobForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Basic Job Details</h5>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Job Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Accessible Software Developer, Customer Support Specialist" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="JobType" class="form-label fw-semibold">Job Type <span class="text-danger">*</span></label>
                                <select asp-for="JobType" class="form-select">
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Internship">Internship</option>
                                    <option value="Volunteer">Volunteer</option>
                                </select>
                                <span asp-validation-for="JobType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WorkplaceType" class="form-label fw-semibold">Workplace Option <span class="text-danger">*</span></label>
                                <select asp-for="WorkplaceType" class="form-select">
                                    <option value="Onsite">Onsite</option>
                                    <option value="Remote">Remote</option>
                                    <option value="Hybrid">Hybrid</option>
                                </select>
                                <span asp-validation-for="WorkplaceType" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-semibold">Location / Address <span class="text-danger">*</span></label>
                                <input asp-for="Location" class="form-control" placeholder="e.g., Banani, Dhaka or Nationwide (Remote)" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Salary" class="form-label fw-semibold">Salary / Compensation</label>
                                <input asp-for="Salary" class="form-control" placeholder="e.g., BDT 35,000 - 50,000 / month or Negotiable" />
                                <span asp-validation-for="Salary" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Job Description & Responsibilities <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Provide a detailed overview of the role, team environment, responsibilities, and growth opportunities..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Accessibility & Workplace Accommodations</h5>

                        <div class="card bg-light border-0 p-3 mb-3">
                            <label class="form-label fw-semibold mb-2">Common Accessibility Features Provided (Select all that apply):</label>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Wheelchair Ramp & Elevator" id="accRamp">
                                        <label class="form-check-label" for="accRamp">Wheelchair Ramp & Elevator Access</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Screen Reader Compatible Workstation" id="accScreen">
                                        <label class="form-check-label" for="accScreen">Screen Reader Compatible Systems</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Accessible Restrooms" id="accRest">
                                        <label class="form-check-label" for="accRest">Accessible Restrooms</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Sign Language Support" id="accSign">
                                        <label class="form-check-label" for="accSign">Sign Language Interpretation Available</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Quiet Work Environment" id="accQuiet">
                                        <label class="form-check-label" for="accQuiet">Quiet / Low Sensory Work Environment</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input acc-checkbox" type="checkbox" value="Ergonomic & Flexible Desks" id="accDesk">
                                        <label class="form-check-label" for="accDesk">Ergonomic & Adjustable Desks</label>
                                    </div>
                                </div>
                            </div>

                            <label asp-for="AccessibilityFeatures" class="form-label fw-semibold small text-muted">Accessibility Features (Comma separated summary):</label>
                            <input asp-for="AccessibilityFeatures" class="form-control" id="accessibilityFeaturesInput" placeholder="Features selected above will appear here, or type your own custom perks..." />
                            <span asp-validation-for="AccessibilityFeatures" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch pt-2">
                                    <input asp-for="FlexibleWorkingHours" class="form-check-input" type="checkbox" id="flexibleHoursSwitch" />
                                    <label asp-for="FlexibleWorkingHours" class="form-check-label fw-semibold">Flexible Working Hours Available</label>
                                </div>
                                <div class="form-text text-muted">Allows candidate to adjust start/end times based on medical or mobility needs.</div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch pt-2">
                                    <input asp-for="AssistiveTechnologySupport" class="form-check-input" type="checkbox" id="assistiveTechSwitch" />
                                    <label asp-for="AssistiveTechnologySupport" class="form-check-label fw-semibold">Assistive Technology Support Provided</label>
                                </div>
                                <div class="form-text text-muted">Organization supplies or supports specialized software, braille displays, etc.</div>
                            </div>
                        </div>

                        <div class="mb-4" id="techDetailsContainer">
                            <label asp-for="AssistiveTechDetails" class="form-label fw-semibold">Assistive Technology Details (Optional)</label>
                            <input asp-for="AssistiveTechDetails" class="form-control" placeholder="e.g., JAWS/NVDA screen readers licensed, high-contrast monitors, dictation software..." />
                            <span asp-validation-for="AssistiveTechDetails" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Skills, Requirements & Deadlines</h5>

                        <div class="mb-3">
                            <label asp-for="RequiredSkills" class="form-label fw-semibold">Required Skills <span class="text-danger">*</span></label>
                            <input asp-for="RequiredSkills" class="form-control" placeholder="e.g., C#, ASP.NET Core, SQL, Communication (comma-separated)" />
                            <span asp-validation-for="RequiredSkills" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="EducationRequirement" class="form-label fw-semibold">Education Requirement</label>
                                <input asp-for="EducationRequirement" class="form-control" placeholder="e.g., Bachelor's in CS, Diploma, or Equivalent Experience" />
                                <span asp-validation-for="EducationRequirement" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExperienceLevel" class="form-label fw-semibold">Experience Level</label>
                                <select asp-for="ExperienceLevel" class="form-select">
                                    <option value="Freshers Welcome">Freshers Welcome</option>
                                    <option value="Entry-level (1-2 years)">Entry-level (1-2 years)</option>
                                    <option value="Mid-level (3-5 years)">Mid-level (3-5 years)</option>
                                    <option value="Senior (5+ years)">Senior (5+ years)</option>
                                </select>
                                <span asp-validation-for="ExperienceLevel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ApplicationDeadline" class="form-label fw-semibold">Application Deadline <span class="text-danger">*</span></label>
                                <input asp-for="ApplicationDeadline" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ApplicationDeadline" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VacancyCount" class="form-label fw-semibold">Number of Vacancies</label>
                                <input asp-for="VacancyCount" type="number" class="form-control" min="1" max="100" />
                                <span asp-validation-for="VacancyCount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <div class="form-check form-switch">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedSwitch" checked />
                                <label asp-for="IsPublished" class="form-check-label fw-semibold">Publish this job immediately</label>
                            </div>
                            <div class="form-text text-muted">If unchecked, the job will be saved as a Draft and won't appear on the public portal until published.</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/Jobs/Manage" class="btn btn-light border">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                <i class="fas fa-check-circle me-2"></i> Publish Opportunity
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var checkboxes = document.querySelectorAll('.acc-checkbox');
        var textInput = document.getElementById('accessibilityFeaturesInput');

        checkboxes.forEach(function (cb) {
            cb.addEventListener('change', updateAccText);
        });

        function updateAccText() {
            var selected = [];
            checkboxes.forEach(function (cb) {
                if (cb.checked) {
                    selected.push(cb.value);
                }
            });
            textInput.value = selected.join(', ');
        }
    </script>
}

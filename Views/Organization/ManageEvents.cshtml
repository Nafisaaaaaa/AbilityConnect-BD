@model IEnumerable<SDP1.Models.AwarenessEvent>
@{
    ViewData["Title"] = "Manage Awareness Events";
    var orgName = ViewBag.UserName ?? "Organization";
    var logo = ViewBag.Logo ?? "/images/default-avatar.png";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar org-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile org-profile">
                    <img src="@logo" alt="Organization" class="profile-img" />
                    <h5>@orgName</h5>
                    <span class="badge bg-primary">Organization</span>
                    <span class="badge bg-success mt-1">Verified</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Organization/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Organization/ManageJobPosts"><i class="fas fa-briefcase"></i> Manage Job Posts</a></li>
                    <li><a href="/Organization/TrainingPrograms"><i class="fas fa-graduation-cap"></i> Training Programs</a></li>
                    <li><a href="/Organization/ManageScholarships"><i class="fas fa-award"></i> Scholarships</a></li>
                    <li class="active"><a href="/Organization/ManageEvents"><i class="fas fa-calendar-alt"></i> Manage Events</a></li>
                    <li><a href="/Organization/ReviewApplications"><i class="fas fa-users"></i> Review Applications</a></li>
                    <li><a href="/Profile/Edit"><i class="fas fa-user-edit"></i> Edit Profile</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="fas fa-calendar-alt text-success me-2"></i> Awareness Campaigns & Events</h2>
                    <p class="text-muted mb-0">Host community webinars, workshops, seminars, and disability rights awareness gatherings.</p>
                </div>
                <a href="/Organization/CreateEvent" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i> Host New Event
                </a>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="get" class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by event title or venue..." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select name="eventType" class="form-select">
                                <option value="">All Event Formats</option>
                                <option value="Disability Awareness" selected="@(ViewBag.EventType == "Disability Awareness")">Disability Awareness</option>
                                <option value="Career Awareness" selected="@(ViewBag.EventType == "Career Awareness")">Career Awareness</option>
                                <option value="Digital Awareness" selected="@(ViewBag.EventType == "Digital Awareness")">Digital Awareness</option>
                                <option value="Educational Seminar" selected="@(ViewBag.EventType == "Educational Seminar")">Educational Seminar</option>
                                <option value="Community Gathering" selected="@(ViewBag.EventType == "Community Gathering")">Community Gathering</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter"></i> Filter</button>
                            <a href="/Organization/ManageEvents" class="btn btn-outline-secondary"><i class="fas fa-redo"></i></a>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Event Title</th>
                                    <th>Format & Venue</th>
                                    <th>Date & Timing</th>
                                    <th>Registrations</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var regCount = item.Registrations?.Count ?? 0;
                                    var statusBadge = item.Status == "Active" ? "bg-success" : (item.Status == "Completed" ? "bg-info text-dark" : "bg-danger");
                                    var isPast = DateTime.UtcNow.Date > item.EventDate.Date;

                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Title</div>
                                            <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> @item.Location</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@item.EventType</span>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold"><i class="fas fa-calendar-day text-primary me-1"></i> @item.EventDate.ToString("MMM dd, yyyy")</div>
                                            <div class="small text-muted"><i class="fas fa-clock me-1"></i> @item.StartTime - @item.EndTime</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark p-2">
                                                <i class="fas fa-users me-1"></i> @regCount Registered
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge">@item.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/Organization/EventRegistrations/@item.Id" class="btn btn-sm btn-outline-primary me-1" title="View Registered Attendees">
                                                <i class="fas fa-users me-1"></i> Attendees (@regCount)
                                            </a>
                                            <a href="/Organization/EditEvent/@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit Event">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="/Organization/DeleteEvent/@item.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Event">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="fas fa-calendar-alt fa-4x text-muted mb-3"></i>
                        <h4 class="fw-bold">No Awareness Events Found</h4>
                        <p class="text-muted mb-4">You have not hosted any awareness events yet or none match your search.</p>
                        <a href="/Organization/CreateEvent" class="btn btn-primary">
                            <i class="fas fa-plus-circle me-1"></i> Host Your First Awareness Event
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@model IEnumerable<SDP1.Models.TrainingProgram>
@{
    ViewData["Title"] = "Manage Training Programs";
    var orgName = ViewBag.UserName ?? "Organization";
    var logo = ViewBag.Logo ?? "/images/default-avatar.png";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar org-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile org-profile">
                    <img src="@logo" alt="Organization" class="profile-img" />
                    <h5>@orgName</h5>
                    <span class="badge bg-primary">Organization</span>
                    <span class="badge bg-success mt-1">Verified</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Organization/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Organization/ManageJobPosts"><i class="fas fa-briefcase"></i> Manage Job Posts</a></li>
                    <li class="active"><a href="/Organization/TrainingPrograms"><i class="fas fa-graduation-cap"></i> Training Programs</a></li>
                    <li><a href="/Organization/ManageScholarships"><i class="fas fa-award"></i> Scholarships</a></li>
                    <li><a href="/Organization/ManageEvents"><i class="fas fa-calendar-alt"></i> Manage Events</a></li>
                    <li><a href="/Organization/ReviewApplications"><i class="fas fa-users"></i> Review Applications</a></li>
                    <li><a href="/Profile/Edit"><i class="fas fa-user-edit"></i> Edit Profile</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="fas fa-graduation-cap text-primary me-2"></i> Training Programs</h2>
                    <p class="text-muted mb-0">Offer skill development and vocational training courses for persons with disabilities.</p>
                </div>
                <a href="/Organization/CreateTraining" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i> Post New Training
                </a>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="get" class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by title, skills, or location..." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select name="category" class="form-select">
                                <option value="">All Categories</option>
                                <option value="Computer Training" selected="@(ViewBag.Category == "Computer Training")">Computer Training</option>
                                <option value="Freelancing" selected="@(ViewBag.Category == "Freelancing")">Freelancing</option>
                                <option value="Digital Skills" selected="@(ViewBag.Category == "Digital Skills")">Digital Skills</option>
                                <option value="Vocational Skills" selected="@(ViewBag.Category == "Vocational Skills")">Vocational Skills</option>
                                <option value="Communication Skills" selected="@(ViewBag.Category == "Communication Skills")">Communication Skills</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter"></i> Filter</button>
                            <a href="/Organization/TrainingPrograms" class="btn btn-outline-secondary"><i class="fas fa-redo"></i></a>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Program Title</th>
                                    <th>Category & Mode</th>
                                    <th>Schedule</th>
                                    <th>Enrollments</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var regCount = item.Registrations?.Count ?? 0;
                                    var capStr = item.MaxParticipants.HasValue ? $"{regCount} / {item.MaxParticipants}" : $"{regCount} Enrolled";
                                    var modeBadge = item.DeliveryMode == "Online" ? "bg-success" : (item.DeliveryMode == "Hybrid" ? "bg-warning text-dark" : "bg-primary");
                                    var statusBadge = item.Status == "Active" ? "bg-success" : "bg-secondary";

                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Title</div>
                                            <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> @item.Location</small>
                                        </td>
                                        <td>
                                            <div><span class="badge bg-light text-dark border">@item.TrainingCategory</span></div>
                                            <span class="badge @modeBadge mt-1">@item.DeliveryMode</span>
                                        </td>
                                        <td>
                                            <div class="small"><i class="fas fa-calendar-alt text-primary me-1"></i> @item.StartDate.ToString("MMM dd, yyyy") - @item.EndDate.ToString("MMM dd, yyyy")</div>
                                            <div class="small text-danger"><i class="fas fa-hourglass-half me-1"></i> Deadline: @item.RegistrationDeadline.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark p-2">
                                                <i class="fas fa-users me-1"></i> @capStr
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge">@item.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/Organization/TrainingRegistrations/@item.Id" class="btn btn-sm btn-outline-primary me-1" title="View Enrolled Participants">
                                                <i class="fas fa-users me-1"></i> Participants (@regCount)
                                            </a>
                                            <a href="/Organization/EditTraining/@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit Program">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="/Organization/DeleteTraining/@item.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this training program?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Program">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="fas fa-graduation-cap fa-4x text-muted mb-3"></i>
                        <h4 class="fw-bold">No Training Programs Found</h4>
                        <p class="text-muted mb-4">You have not published any training programs matching your search criteria.</p>
                        <a href="/Organization/CreateTraining" class="btn btn-primary">
                            <i class="fas fa-plus-circle me-1"></i> Post Your First Training Program
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@model SDP1.Models.TrainingProgram
@{
    ViewData["Title"] = "Training Participants - " + Model.Title;
    var orgName = ViewBag.UserName ?? "Organization";
    var logo = ViewBag.Logo ?? "/images/default-avatar.png";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar org-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile org-profile">
                    <img src="@logo" alt="Organization" class="profile-img" />
                    <h5>@orgName</h5>
                    <span class="badge bg-primary">Organization</span>
                    <span class="badge bg-success mt-1">Verified</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Organization/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Organization/ManageJobPosts"><i class="fas fa-briefcase"></i> Manage Job Posts</a></li>
                    <li class="active"><a href="/Organization/TrainingPrograms"><i class="fas fa-graduation-cap"></i> Training Programs</a></li>
                    <li><a href="/Organization/ManageScholarships"><i class="fas fa-award"></i> Scholarships</a></li>
                    <li><a href="/Organization/ManageEvents"><i class="fas fa-calendar-alt"></i> Manage Events</a></li>
                    <li><a href="/Organization/ReviewApplications"><i class="fas fa-users"></i> Review Applications</a></li>
                    <li><a href="/Profile/Edit"><i class="fas fa-user-edit"></i> Edit Profile</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="mb-4">
                <a href="/Organization/TrainingPrograms" class="btn btn-outline-secondary btn-sm mb-2">
                    <i class="fas fa-arrow-left me-1"></i> Back to Training Programs
                </a>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="fas fa-users text-primary me-2"></i> Enrolled Participants</h2>
                        <h5 class="text-secondary">@Model.Title</h5>
                    </div>
                    <div>
                        <span class="badge bg-primary p-2 fs-6">
                            Total Enrolled: @(Model.Registrations?.Count ?? 0)
                            @if (Model.MaxParticipants.HasValue)
                            {
                                <span>/ @Model.MaxParticipants.Value</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            @if (Model.Registrations != null && Model.Registrations.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Participant Name</th>
                                    <th>Disability Type</th>
                                    <th>Contact Details</th>
                                    <th>Registered Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Update Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reg in Model.Registrations.OrderByDescending(r => r.RegisteredAt))
                                {
                                    var u = reg.DisabilityUser;
                                    var statusBadge = reg.Status == "Attended" ? "bg-success" : (reg.Status == "Cancelled" ? "bg-danger" : "bg-primary");
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@(u?.FullName ?? "User #" + reg.DisabilityUserId)</div>
                                            <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> @(u?.Location ?? "N/A")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark">@(u?.DisabilityType ?? "Not Specified")</span>
                                        </td>
                                        <td>
                                            <div><i class="fas fa-envelope text-muted me-1"></i> @(u?.Email ?? "N/A")</div>
                                            <div class="small"><i class="fas fa-phone text-muted me-1"></i> @(u?.PhoneNumber ?? "N/A")</div>
                                        </td>
                                        <td>
                                            <small><i class="fas fa-clock text-muted me-1"></i> @reg.RegisteredAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge">@reg.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <form method="post" action="/Organization/UpdateTrainingRegistrationStatus" class="d-inline-flex gap-1 align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@reg.Id" />
                                                <select name="status" class="form-select form-select-sm" style="width: auto;">
                                                    <option value="Registered" selected="@(reg.Status == "Registered")">Registered</option>
                                                    <option value="Attended" selected="@(reg.Status == "Attended")">Attended</option>
                                                    <option value="Cancelled" selected="@(reg.Status == "Cancelled")">Cancelled</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Save Status">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="fas fa-user-friends fa-4x text-muted mb-3"></i>
                        <h4 class="fw-bold">No Participants Enrolled Yet</h4>
                        <p class="text-muted">When disability users register for this training course, their details and contact information will appear here.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

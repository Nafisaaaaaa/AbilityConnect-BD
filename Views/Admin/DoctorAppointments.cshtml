@model List<SDP1.Models.HealthcareAppointment>
@{
    ViewData["Title"] = "Doctor & Healthcare Appointments";
    var adminName = ViewBag.AdminName ?? "Administrator";
    var currentFilter = ViewBag.CurrentStatusFilter as string ?? "All";
    var selectedProviderId = ViewBag.SelectedProviderId as int?;
    var allProviders = ViewBag.AllProviders as List<SDP1.Models.HealthcareProvider> ?? new List<SDP1.Models.HealthcareProvider>();

    var pendingCount = Model.Count(a => a.Status == "Pending");
    var confirmedCount = Model.Count(a => a.Status == "Confirmed");
    var completedCount = Model.Count(a => a.Status == "Completed");
    var cancelledCount = Model.Count(a => a.Status == "Cancelled");
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Admin/HealthcareProviders"><i class="fas fa-user-md"></i> Healthcare Providers</a></li>
                    <li class="active"><a href="/Admin/DoctorAppointments"><i class="fas fa-calendar-check"></i> Doctor Appointments</a></li>
                    <li><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Admin/LearningHub"><i class="fas fa-book-reader"></i> Learning Hub</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-calendar-check text-primary me-2"></i> Doctor & Healthcare Appointments</h3>
                    <p class="text-muted mb-0">Overview of all healthcare consultation bookings submitted by persons with disabilities.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Admin/HealthcareProviders" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-user-md me-1"></i> Healthcare Providers
                    </a>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #3182CE !important;">
                        <span class="text-muted small">Total Appointments</span>
                        <h4 class="fw-bold text-dark mb-0">@Model.Count</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #DD6B20 !important;">
                        <span class="text-muted small">Pending Requests</span>
                        <h4 class="fw-bold text-warning mb-0">@pendingCount</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #38A169 !important;">
                        <span class="text-muted small">Confirmed</span>
                        <h4 class="fw-bold text-success mb-0">@confirmedCount</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border-left: 4px solid #805AD5 !important;">
                        <span class="text-muted small">Completed</span>
                        <h4 class="fw-bold text-info mb-0">@completedCount</h4>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <select name="statusFilter" class="form-select form-select-sm">
                            <option value="All" selected="@(currentFilter == "All")">All Statuses</option>
                            <option value="Pending" selected="@(currentFilter == "Pending")">Pending</option>
                            <option value="Confirmed" selected="@(currentFilter == "Confirmed")">Confirmed</option>
                            <option value="Completed" selected="@(currentFilter == "Completed")">Completed</option>
                            <option value="Cancelled" selected="@(currentFilter == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="providerId" class="form-select form-select-sm">
                            <option value="">All Providers</option>
                            @foreach (var prov in allProviders)
                            {
                                <option value="@prov.Id" selected="@(selectedProviderId == prov.Id)">@prov.Name (@prov.ProviderType)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Filter</button>
                    </div>
                    <div class="col-md-2 d-grid">
                        <a href="/Admin/DoctorAppointments" class="btn btn-outline-secondary btn-sm">Reset</a>
                    </div>
                </form>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body p-4">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-calendar-times fa-3x mb-2" style="opacity: 0.4;"></i>
                            <p class="mb-0">No healthcare appointments found matching the selected criteria.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Patient / User</th>
                                        <th>Healthcare Provider</th>
                                        <th>Date & Slot</th>
                                        <th>Reason & Accommodation Notes</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appt in Model)
                                    {
                                        var statusClass = appt.Status switch
                                        {
                                            "Confirmed" => "bg-success",
                                            "Pending" => "bg-warning text-dark",
                                            "Completed" => "bg-info text-white",
                                            "Cancelled" => "bg-danger text-white",
                                            _ => "bg-secondary"
                                        };

                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@(appt.DisabilityUser?.FullName ?? "User #" + appt.DisabilityUserId)</div>
                                                @if (!string.IsNullOrEmpty(appt.DisabilityUser?.DisabilityType))
                                                {
                                                    <span class="badge bg-light text-primary border mb-1" style="font-size: 0.75rem;">@appt.DisabilityUser.DisabilityType</span>
                                                }
                                                <small class="text-muted d-block"><i class="fas fa-envelope me-1"></i> @(appt.DisabilityUser?.Email ?? "N/A")</small>
                                                @if (!string.IsNullOrEmpty(appt.DisabilityUser?.PhoneNumber))
                                                {
                                                    <small class="text-muted d-block"><i class="fas fa-phone me-1"></i> @appt.DisabilityUser.PhoneNumber</small>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@(appt.HealthcareProvider?.Name ?? "Provider #" + appt.HealthcareProviderId)</div>
                                                <span class="badge bg-light text-secondary border mb-1" style="font-size: 0.75rem;">@(appt.HealthcareProvider?.ProviderType ?? "Healthcare")</span>
                                                @if (!string.IsNullOrEmpty(appt.HealthcareProvider?.Specialization))
                                                {
                                                    <small class="text-muted d-block">@appt.HealthcareProvider.Specialization</small>
                                                }
                                                @if (!string.IsNullOrEmpty(appt.HealthcareProvider?.OrganizationOrClinic))
                                                {
                                                    <small class="text-muted d-block"><i class="fas fa-hospital me-1"></i> @appt.HealthcareProvider.OrganizationOrClinic</small>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark"><i class="fas fa-calendar-day text-primary me-1"></i> @appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                                <small class="text-muted"><i class="fas fa-clock text-info me-1"></i> @appt.TimeSlot</small>
                                            </td>
                                            <td style="max-width: 280px;">
                                                <div class="text-dark small fw-semibold">@appt.ReasonForVisit</div>
                                                @if (!string.IsNullOrEmpty(appt.PatientNotes))
                                                {
                                                    <div class="mt-1 p-1 px-2 rounded bg-light border text-secondary small" title="Accommodation / Patient Notes">
                                                        <i class="fas fa-notes-medical text-primary me-1"></i> <em>@appt.PatientNotes</em>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">No notes provided</small>
                                                }
                                                @if (!string.IsNullOrEmpty(appt.DoctorNotes))
                                                {
                                                    <div class="mt-1 small text-success">
                                                        <i class="fas fa-clipboard-check me-1"></i> <strong>Doctor Notes:</strong> @appt.DoctorNotes
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @statusClass px-2 py-1">@appt.Status</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    @if (appt.Status == "Pending")
                                                    {
                                                        <form asp-action="UpdateDoctorAppointmentStatus" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@appt.Id" />
                                                            <input type="hidden" name="status" value="Confirmed" />
                                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Confirm Appointment">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (appt.Status == "Confirmed")
                                                    {
                                                        <form asp-action="UpdateDoctorAppointmentStatus" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@appt.Id" />
                                                            <input type="hidden" name="status" value="Completed" />
                                                            <button type="submit" class="btn btn-sm btn-outline-info" title="Mark Completed">
                                                                <i class="fas fa-flag-checkered"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (appt.Status != "Cancelled" && appt.Status != "Completed")
                                                    {
                                                        <form asp-action="UpdateDoctorAppointmentStatus" method="post" class="d-inline" onsubmit="return confirm('Cancel this appointment?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@appt.Id" />
                                                            <input type="hidden" name="status" value="Cancelled" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Appointment">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

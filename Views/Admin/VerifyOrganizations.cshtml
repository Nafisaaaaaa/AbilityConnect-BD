@model IEnumerable<SDP1.Models.Organization>
@{
    ViewData["Title"] = "Verify Organizations";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li class="active"><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="page-header">
                <h3><i class="fas fa-building"></i> Verify Organizations</h3>
                <p class="text-muted">Total: @Model.Count() organizations</p>
            </div>

            <div class="activity-table">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Organization</th>
                            <th>Type</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var org in Model)
                            {
                                <tr>
                                    <td>@org.Id</td>
                                    <td>
                                        <img src="@(org.Logo ?? "/images/default-avatar.png")" class="user-avatar-sm" />
                                        @org.OrganizationName
                                    </td>
                                    <td><span class="badge bg-info">@org.OrganizationType</span></td>
                                    <td>@org.Email</td>
                                    <td>@org.City</td>
                                    <td>
                                        @if (org.IsVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal" data-bs-target="#orgModal-@org.Id">
                                            <i class="fas fa-eye"></i> View
                                        </button>

                                        @if (!org.IsVerified)
                                        {
                                            <form asp-action="VerifyOrganization" asp-route-id="@org.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="fas fa-check"></i> Verify
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnverifyOrganization" asp-route-id="@org.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-times"></i> Unverify
                                                </button>
                                            </form>
                                        }
                                        <a href="/Admin/DeleteOrganization/@org.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No organizations registered yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    foreach (var org in Model)
    {
        <div class="modal fade" id="orgModal-@org.Id" tabindex="-1" aria-labelledby="orgModalLabel-@org.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="orgModalLabel-@org.Id">
                            <i class="fas fa-building"></i> @org.OrganizationName
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-3 text-center mb-3">
                                <img src="@(org.Logo ?? "/images/default-avatar.png")" class="modal-avatar" />
                                <h6 class="mt-2">@org.OrganizationName</h6>
                                @if (org.IsVerified)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle"></i> Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning"><i class="fas fa-clock"></i> Pending</span>
                                }
                            </div>
                            <div class="col-md-9">
                                <div class="row">
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Organization Type</label>
                                        <p><span class="badge bg-info">@org.OrganizationType</span></p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Email</label>
                                        <p>@org.Email</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Phone</label>
                                        <p>@org.PhoneNumber</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>City</label>
                                        <p>@org.City</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Division</label>
                                        <p>@org.Division</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Address</label>
                                        <p>@org.Address</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Website</label>
                                        <p>
                                            @if (!string.IsNullOrEmpty(org.Website))
                                            {
                                                <a href="@org.Website" target="_blank">@org.Website</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Facebook</label>
                                        <p>
                                            @if (!string.IsNullOrEmpty(org.FacebookProfileLink))
                                            {
                                                <a href="@org.FacebookProfileLink" target="_blank">View Profile</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="col-12 modal-detail-item">
                                        <label>Description</label>
                                        <p>@org.OrganizationDescription</p>
                                    </div>

                                    <div class="col-12"><hr /></div>
                                    <div class="col-12">
                                        <h6 class="mb-3"><i class="fas fa-user-tie"></i> Contact Person</h6>
                                    </div>

                                    <div class="col-md-6 modal-detail-item">
                                        <label>Name</label>
                                        <p>@org.ContactPersonName</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Designation</label>
                                        <p>@org.ContactPersonDesignation</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Contact Phone</label>
                                        <p>@org.ContactPersonPhone</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Contact Email</label>
                                        <p>@org.ContactPersonEmail</p>
                                    </div>
                                    <div class="col-md-6 modal-detail-item">
                                        <label>Registered At</label>
                                        <p>@org.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</p>
                                    </div>
                                    @if (org.UpdatedAt.HasValue)
                                    {
                                        <div class="col-md-6 modal-detail-item">
                                            <label>Last Updated</label>
                                            <p>@org.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        @if (!org.IsVerified)
                        {
                            <form asp-action="VerifyOrganization" asp-route-id="@org.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-check-circle"></i> Verify
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="UnverifyOrganization" asp-route-id="@org.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-times-circle"></i> Unverify
                                </button>
                            </form>
                        }
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i> Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Styles {
    <style>
        .admin-sidebar .sidebar-nav li.active a {
            background: var(--primary-light);
            color: var(--primary-color);
            border-left-color: var(--primary-color);
        }

        .page-header {
            margin-bottom: 24px;
        }

        .user-avatar-sm {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 8px;
        }

        .text-center {
            text-align: center;
        }

        .text-muted {
            color: var(--text-muted);
        }

        .btn-outline-warning {
            border-color: var(--warning-color);
            color: var(--warning-color);
        }

            .btn-outline-warning:hover {
                background: var(--warning-color);
                color: white;
            }

        .btn-outline-success {
            border-color: var(--success-color);
            color: var(--success-color);
        }

            .btn-outline-success:hover {
                background: var(--success-color);
                color: white;
            }

        .modal-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--primary-color);
        }

        .modal-detail-item {
            margin-bottom: 14px;
        }

            .modal-detail-item label {
                font-size: 0.75rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                font-weight: 600;
                display: block;
                margin-bottom: 2px;
            }

            .modal-detail-item p {
                font-size: 0.9rem;
                color: var(--text-primary);
                margin: 0;
            }

        .modal-content {
            border: none;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
        }

        .modal-header {
            background: var(--bg-light);
            border-bottom: 1px solid var(--border-color);
            border-top-left-radius: var(--radius-md);
            border-top-right-radius: var(--radius-md);
        }

        .modal-footer {
            border-top: 1px solid var(--border-color);
        }
    </style>
}
@model SDP1.Models.AdminCommunityReportsViewModel
@{
    ViewData["Title"] = "Community Reports Moderation";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Admin/HealthcareProviders"><i class="fas fa-user-md"></i> Healthcare Providers</a></li>
                    <li><a href="/Admin/JobsAndPrograms"><i class="fas fa-briefcase"></i> Jobs & Programs</a></li>
                    <li><a href="/Admin/AccessibilityPlaces"><i class="fas fa-map-marked-alt"></i> Accessibility Places</a></li>
                    <li class="active"><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Admin/LearningHub"><i class="fas fa-book-reader"></i> Learning Hub</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
                    <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="fas fa-flag text-danger me-2"></i>Community Reports Moderation
                    </h3>
                    <p class="text-muted mb-0">Unified moderation for reported Community Posts, Comments, and Physical Accessibility Barriers.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Admin/AccessibilityPlaces" class="btn btn-outline-primary">
                        <i class="fas fa-map-marked-alt me-1"></i> Accessibility Places
                    </a>
                    <a href="/Community" target="_blank" class="btn btn-outline-secondary">
                        <i class="fas fa-external-link-alt me-1"></i> Community Feed
                    </a>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 rounded-4">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-secondary-subtle text-secondary rounded-3 me-3">
                                <i class="fas fa-layer-group fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Total Reports</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.TotalCount</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 rounded-4">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-warning-subtle text-warning rounded-3 me-3">
                                <i class="fas fa-clock fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Pending</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.PendingCount</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 rounded-4">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-info-subtle text-info rounded-3 me-3">
                                <i class="fas fa-search fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Reviewed</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.ReviewedCount</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm bg-white p-3 rounded-4">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-danger-subtle text-danger rounded-3 me-3">
                                <i class="fas fa-map-marker-alt fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Location Reports</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.LocationReportsCount</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-white rounded-4 mb-4 p-3">
                <form method="get" asp-action="CommunityReports" class="row g-2 align-items-center">
                    <div class="col-auto">
                        <span class="small fw-semibold text-muted">Type:</span>
                    </div>
                    <div class="col-auto">
                        <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="All" selected="@(Model.CurrentType == "All")">All Types (@Model.TotalCount)</option>
                            <option value="Location" selected="@(Model.CurrentType == "Location")">Location Reports (@Model.LocationReportsCount)</option>
                            <option value="Post" selected="@(Model.CurrentType == "Post")">Post Reports (@Model.PostReportsCount)</option>
                            <option value="Comment" selected="@(Model.CurrentType == "Comment")">Comment Reports (@Model.CommentReportsCount)</option>
                        </select>
                    </div>

                    <div class="col-auto ms-md-3">
                        <span class="small fw-semibold text-muted">Status:</span>
                    </div>
                    <div class="col-auto">
                        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="All" selected="@(Model.CurrentStatus == "All")">All Statuses</option>
                            <option value="Pending" selected="@(Model.CurrentStatus == "Pending")">Pending (@Model.PendingCount)</option>
                            <option value="Reviewed" selected="@(Model.CurrentStatus == "Reviewed")">Reviewed (@Model.ReviewedCount)</option>
                            <option value="Resolved" selected="@(Model.CurrentStatus == "Resolved")">Resolved (@Model.ResolvedCount)</option>
                            <option value="Rejected" selected="@(Model.CurrentStatus == "Rejected")">Rejected</option>
                        </select>
                    </div>

                    <div class="col-auto ms-md-3">
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="Search reasons, places, users..." />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                    </div>

                    <div class="col-auto ms-auto">
                        <a href="/Admin/CommunityReports" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>

            @if (!Model.Reports.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="fas fa-check-circle text-muted opacity-50 fa-3x mb-3"></i>
                    <h5 class="fw-bold text-dark">No Community Reports Found</h5>
                    <p class="text-muted small">No reports currently match the selected criteria.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var report in Model.Reports)
                    {
                        var statusBadgeClass = report.Status switch
                        {
                            "Resolved" => "bg-success text-white",
                            "Reviewed" => "bg-info text-dark",
                            "Rejected" => "bg-secondary text-white",
                            _ => "bg-warning text-dark"
                        };

                        var typeBadgeClass = report.ReportType switch
                        {
                            "Location" => "bg-danger-subtle text-danger border-danger",
                            "Post" => "bg-primary-subtle text-primary border-primary",
                            "Comment" => "bg-info-subtle text-info border-info",
                            _ => "bg-light text-dark"
                        };

                        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4">
                            <div class="row g-3">
                                <div class="col-lg-8">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="badge border @typeBadgeClass px-2 py-1">
                                            @if (report.ReportType == "Location")
                                            {
                                                <i class="fas fa-map-marker-alt me-1"></i>
                                            }
                                            else if (report.ReportType == "Post")
                                            {
                                                <i class="fas fa-newspaper me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-comment me-1"></i>
                                            }
                                            @report.ReportType Report #@report.Id
                                        </span>

                                        <span class="badge @statusBadgeClass px-2 py-1">
                                            @report.Status
                                        </span>

                                        <span class="text-muted small ms-auto">
                                            <i class="fas fa-clock me-1"></i>@report.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        <h5 class="fw-bold text-dark mb-1">
                                            Reason: <span class="text-danger">@report.Reason</span>
                                        </h5>

                                        @if (report.ReportType == "Location")
                                        {
                                            <div class="p-3 bg-light rounded-3 mb-2 border">
                                                <div class="fw-bold text-dark">
                                                    <i class="fas fa-building text-primary me-1"></i>@(report.PlaceName ?? "Unnamed Location")
                                                </div>
                                                @if (!string.IsNullOrEmpty(report.Address))
                                                {
                                                    <div class="small text-muted"><i class="fas fa-map-pin me-1"></i>@report.Address</div>
                                                }
                                                @if (report.Latitude.HasValue && report.Longitude.HasValue)
                                                {
                                                    <div class="small text-muted">
                                                        <i class="fas fa-globe me-1"></i>Coordinates: @report.Latitude.Value.ToString("F5"), @report.Longitude.Value.ToString("F5")
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (report.ReportType == "Post" && report.Post != null)
                                        {
                                            <div class="p-3 bg-light rounded-3 mb-2 border">
                                                <div class="small fw-bold text-primary mb-1">
                                                    Post by @(report.Post.AuthorName) (@report.Post.UserRole)
                                                </div>
                                                <div class="small text-dark">@report.Post.Content</div>
                                                @if (!string.IsNullOrEmpty(report.Post.ImagePath))
                                                {
                                                    <div class="mt-1">
                                                        <a href="@report.Post.ImagePath" target="_blank" class="small text-primary"><i class="fas fa-image me-1"></i>View Attached Image</a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (report.ReportType == "Comment" && report.Comment != null)
                                        {
                                            <div class="p-3 bg-light rounded-3 mb-2 border">
                                                <div class="small fw-bold text-primary mb-1">
                                                    Comment by @(report.Comment.AuthorName) (@report.Comment.UserRole)
                                                </div>
                                                <div class="small text-dark">@report.Comment.Content</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(report.Details))
                                        {
                                            <div class="small text-dark">
                                                <strong>Reporter Notes:</strong> @report.Details
                                            </div>
                                        }

                                        <div class="small text-muted mt-2">
                                            Reported by: <strong>@(report.ReporterName ?? "User")</strong>
                                            <span class="badge bg-light text-secondary border ms-1">@report.ReporterUserRole</span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(report.AdminNotes))
                                        {
                                            <div class="small text-info mt-1">
                                                <strong>Admin Note:</strong> @report.AdminNotes
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-lg-4 d-flex flex-column justify-content-between">
                                    @if (report.ReportType == "Location" && report.Latitude.HasValue && report.Longitude.HasValue)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-bold text-dark"><i class="fas fa-map me-1 text-primary"></i>OpenStreetMap Location</span>
                                                <a href="https://www.openstreetmap.org/?mlat=@report.Latitude.Value&mlon=@report.Longitude.Value#map=16/@report.Latitude.Value/@report.Longitude.Value" target="_blank" class="small text-decoration-none">
                                                    Open <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            </div>
                                            <div id="map-report-@report.Id" class="rounded-3 border" style="height: 150px; width: 100%;"></div>
                                        </div>
                                    }

                                    <div class="border-top pt-3 mt-auto">
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            @if (report.Status != "Reviewed")
                                            {
                                                <form method="post" asp-action="UpdateCommunityReportStatus" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@report.Id" />
                                                    <input type="hidden" name="status" value="Reviewed" />
                                                    <button type="submit" class="btn btn-sm btn-outline-info" title="Mark as Reviewed">
                                                        <i class="fas fa-check"></i> Mark Reviewed
                                                    </button>
                                                </form>
                                            }

                                            @if (report.Status != "Resolved")
                                            {
                                                <form method="post" asp-action="UpdateCommunityReportStatus" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@report.Id" />
                                                    <input type="hidden" name="status" value="Resolved" />
                                                    <button type="submit" class="btn btn-sm btn-success" title="Mark as Resolved">
                                                        <i class="fas fa-check-double"></i> Resolve
                                                    </button>
                                                </form>
                                            }

                                            @if (report.Status != "Rejected")
                                            {
                                                <form method="post" asp-action="UpdateCommunityReportStatus" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@report.Id" />
                                                    <input type="hidden" name="status" value="Rejected" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Reject Report">
                                                        <i class="fas fa-times"></i> Reject
                                                    </button>
                                                </form>
                                            }

                                            <form method="post" asp-action="DeleteCommunityReport" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete report #@report.Id?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@report.Id" />
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete Report">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @foreach (var report in Model.Reports.Where(r => r.ReportType == "Location" && r.Latitude.HasValue && r.Longitude.HasValue))
            {
                <text>
                (function() {
                    const lat = @report.Latitude.Value;
                    const lng = @report.Longitude.Value;
                    const mapId = 'map-report-@report.Id';
                    const el = document.getElementById(mapId);
                    if (el) {
                        const m = L.map(mapId, { zoomControl: false, attributionControl: false }).setView([lat, lng], 14);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(m);
                        L.marker([lat, lng]).addTo(m).bindPopup('@Html.Raw((report.PlaceName ?? "Barrier Location").Replace("'", "\\'"))');
                    }
                })();
                </text>
            }
        });
    </script>
}

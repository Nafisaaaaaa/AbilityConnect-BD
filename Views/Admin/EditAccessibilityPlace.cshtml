@model SDP1.Models.AccessibilityPlaceFormViewModel
@{
    ViewData["Title"] = "Edit Accessibility Place";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Admin/JobsAndPrograms"><i class="fas fa-briefcase"></i> Jobs & Programs</a></li>
                    <li><a href="/Admin/HealthcareProviders"><i class="fas fa-user-md"></i> Healthcare Providers</a></li>
                    <li class="active"><a href="/Admin/AccessibilityPlaces"><i class="fas fa-map-marked-alt"></i> Accessibility Places</a></li>
                    <li><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            <div class="mb-4">
                <a href="/Admin/AccessibilityPlaces" class="btn btn-outline-secondary btn-sm mb-3">
                    <i class="fas fa-arrow-left me-1"></i> Back to Places List
                </a>
                <h3 class="fw-bold mb-1"><i class="fas fa-edit text-primary me-2"></i>Edit Accessibility Place</h3>
                <p class="text-muted">Update place specifications, verified features, and score.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 max-w-3xl">
                <form method="post" asp-action="EditAccessibilityPlace">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="PlaceName" class="form-label fw-semibold small text-dark">Place Name *</label>
                            <input asp-for="PlaceName" class="form-control" required />
                            <span asp-validation-for="PlaceName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PlaceType" class="form-label fw-semibold small text-dark">Place Type *</label>
                            <select asp-for="PlaceType" class="form-select" required>
                                <option value="Hospital">Hospital</option>
                                <option value="Shopping Mall">Shopping Mall</option>
                                <option value="Public Park">Public Park</option>
                                <option value="Transit Station">Transit Station</option>
                                <option value="Government Office">Government Office</option>
                                <option value="School">School / University</option>
                                <option value="Restaurant">Restaurant</option>
                                <option value="Bank">Bank</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="PlaceType" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold small text-dark">Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small text-dark">Street Address *</label>
                            <input asp-for="Address" class="form-control" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold small text-dark">City *</label>
                            <input asp-for="City" class="form-control" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="District" class="form-label fw-semibold small text-dark">District *</label>
                            <input asp-for="District" class="form-control" required />
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label fw-semibold small text-dark">Latitude (Decimal) *</label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" required />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label fw-semibold small text-dark">Longitude (Decimal) *</label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" required />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark d-block">Accessibility Features</label>
                            <div class="d-flex flex-wrap gap-4 pt-1">
                                <div class="form-check">
                                    <input asp-for="WheelchairRamp" class="form-check-input" type="checkbox" id="rampInput" />
                                    <label class="form-check-label" for="rampInput">Wheelchair Ramp</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Elevator" class="form-check-input" type="checkbox" id="elevatorInput" />
                                    <label class="form-check-label" for="elevatorInput">Elevator</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="AccessibleToilet" class="form-check-input" type="checkbox" id="toiletInput" />
                                    <label class="form-check-label" for="toiletInput">Accessible Toilet</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="AccessibleParking" class="form-check-input" type="checkbox" id="parkingInput" />
                                    <label class="form-check-label" for="parkingInput">Accessible Parking</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AccessibilityScore" class="form-label fw-semibold small text-dark">Accessibility Score (0 - 100) *</label>
                            <input asp-for="AccessibilityScore" type="number" min="0" max="100" class="form-control" required />
                            <span asp-validation-for="AccessibilityScore" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        <a href="/Admin/AccessibilityPlaces" class="btn btn-outline-secondary px-3">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<SDP1.Models.Volunteer>
@{
    ViewData["Title"] = "Manage Volunteers";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li class="active"><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Admin/JobsAndPrograms"><i class="fas fa-briefcase"></i> Jobs & Programs</a></li>
                    <li><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="page-header">
                <h3><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</h3>
                <p class="text-muted">Total: @Model.Count() volunteers</p>
            </div>

            <div class="activity-table">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Location</th>
                            <th>Skills</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var vol in Model)
                            {
                                <tr>
                                    <td>@vol.Id</td>
                                    <td>
                                        <img src="@(vol.ProfilePicture ?? "/images/default-avatar.png")" class="user-avatar-sm" />
                                        @vol.FullName
                                    </td>
                                    <td>@vol.Email</td>
                                    <td>@vol.Location</td>
                                    <td>@vol.Skills</td>
                                    <td>
                                        @if (vol.IsVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>@vol.RegisteredAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a href="/Admin/VolunteerProfile/@vol.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        @if (!vol.IsVerified)
                                        {
                                            <form asp-action="VerifyVolunteer" asp-route-id="@vol.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="fas fa-check"></i> Verify
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnverifyVolunteer" asp-route-id="@vol.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-times"></i> Unverify
                                                </button>
                                            </form>
                                        }
                                        <a href="/Admin/DeleteVolunteer/@vol.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No volunteers registered yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .admin-sidebar .sidebar-nav li.active a {
            background: var(--primary-light);
            color: var(--primary-color);
            border-left-color: var(--primary-color);
        }

        .page-header {
            margin-bottom: 24px;
        }

        .user-avatar-sm {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 8px;
        }

        .text-center {
            text-align: center;
        }

        .text-muted {
            color: var(--text-muted);
        }

        .btn-outline-warning {
            border-color: var(--warning-color);
            color: var(--warning-color);
        }

            .btn-outline-warning:hover {
                background: var(--warning-color);
                color: white;
            }

        .btn-outline-success {
            border-color: var(--success-color);
            color: var(--success-color);
        }

            .btn-outline-success:hover {
                background: var(--success-color);
                color: white;
            }

        .activity-table .table td {
            vertical-align: middle;
        }
    </style>
}
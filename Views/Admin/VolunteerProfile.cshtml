@model SDP1.Models.Volunteer
@{
    ViewData["Title"] = "Volunteer Profile";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li class="active"><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            <div class="page-header">
                <h3><i class="fas fa-user"></i> Volunteer Profile</h3>
                <a href="/Admin/ManageVolunteers" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="detail-card">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <img src="@(Model.ProfilePicture ?? "/images/default-avatar.png")" class="detail-avatar" />
                        <h5 class="mt-3">@Model.FullName</h5>
                        @if (Model.IsVerified)
                        {
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-warning"><i class="fas fa-clock"></i> Pending Verification</span>
                        }
                    </div>
                    <div class="col-md-9">
                        <div class="row">
                            <div class="col-md-6 detail-item">
                                <label>Email</label>
                                <p>@Model.Email</p>
                            </div>
                            <div class="col-md-6 detail-item">
                                <label>Phone</label>
                                <p>@Model.PhoneNumber</p>
                            </div>
                            <div class="col-md-6 detail-item">
                                <label>Location</label>
                                <p>@Model.Location</p>
                            </div>
                            <div class="col-md-6 detail-item">
                                <label>Availability</label>
                                <p>@(Model.Availability ?? "Not specified")</p>
                            </div>
                            <div class="col-md-6 detail-item">
                                <label>Experience</label>
                                <p>@(Model.Experience ?? "Not specified")</p>
                            </div>
                            <div class="col-md-6 detail-item">
                                <label>Registered At</label>
                                <p>@Model.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</p>
                            </div>
                            <div class="col-md-12 detail-item">
                                <label>Skills</label>
                                <p>@Model.Skills</p>
                            </div>
                            <div class="col-md-12 detail-item">
                                <label>Languages Spoken</label>
                                <p>@(Model.LanguagesSpoken ?? "Not specified")</p>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!Model.IsVerified)
                {
                    <form asp-action="VerifyVolunteer" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success mt-3">
                            <i class="fas fa-check-circle"></i> Verify This Volunteer
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="UnverifyVolunteer" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning mt-3">
                            <i class="fas fa-times-circle"></i> Unverify Volunteer
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .admin-sidebar .sidebar-nav li.active a {
            background: var(--primary-light);
            color: var(--primary-color);
            border-left-color: var(--primary-color);
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .detail-card {
            background: var(--bg-white);
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            padding: 32px;
        }

        .detail-avatar {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--success-color);
        }

        .detail-item {
            margin-bottom: 20px;
        }

            .detail-item label {
                font-size: 0.85rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                font-weight: 600;
                display: block;
                margin-bottom: 4px;
            }

            .detail-item p {
                font-size: 1rem;
                color: var(--text-primary);
                margin: 0;
            }
    </style>
}
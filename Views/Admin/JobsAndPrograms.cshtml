@model IEnumerable<SDP1.Models.Job>
@{
    ViewData["Title"] = "Jobs & Programs Management";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li class="active"><a href="/Admin/JobsAndPrograms"><i class="fas fa-briefcase"></i> Jobs & Programs</a></li>
                    <li><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-briefcase text-primary me-2"></i>Platform Jobs & Programs</h3>
                    <p class="text-muted mb-0">Total: @Model.Count() job postings across all organizations</p>
                </div>
                <a href="/Jobs" class="btn btn-outline-primary" target="_blank">
                    <i class="fas fa-external-link-alt me-1"></i> Public Job Portal
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-white p-3">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-primary-subtle text-primary rounded-3 me-3">
                                <i class="fas fa-briefcase fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Total Postings</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.Count()</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-white p-3">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-success-subtle text-success rounded-3 me-3">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Active Jobs</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.Count(j => j.JobStatus == "Active")</h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-white p-3">
                        <div class="d-flex align-items-center">
                            <div class="p-3 bg-info-subtle text-info rounded-3 me-3">
                                <i class="fas fa-users fa-2x"></i>
                            </div>
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Total Applications</span>
                                <h3 class="fw-bold text-dark mb-0">@Model.Sum(j => j.JobApplications?.Count ?? 0)</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="card shadow-sm border-0 text-center py-5 bg-white">
                    <div class="card-body">
                        <div class="mb-3 text-muted" style="font-size: 3.5rem;">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <h4 class="fw-bold text-dark">No Job Postings Yet</h4>
                        <p class="text-muted max-w-md mx-auto">
                            No organizations have posted any jobs on the platform yet.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Job Title</th>
                                    <th scope="col">Organization</th>
                                    <th scope="col">Location / Type</th>
                                    <th scope="col">Posted Date</th>
                                    <th scope="col">Deadline</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Applicants</th>
                                    <th scope="col" class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <h6 class="fw-bold mb-0">
                                                <a href="/Jobs/Details/@job.Id" class="text-dark text-decoration-none hover-primary">@job.Title</a>
                                            </h6>
                                            <span class="text-muted small">@job.JobType</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-primary">
                                                <i class="fas fa-building me-1"></i>@(job.Organization?.OrganizationName ?? "Unknown Org")
                                            </div>
                                            <div class="small text-muted">@(job.Organization?.Email ?? "")</div>
                                        </td>
                                        <td>
                                            <div class="small">@job.Location</div>
                                            <span class="badge bg-light text-dark border">@job.WorkplaceType</span>
                                        </td>
                                        <td class="text-muted small">
                                            @job.CreatedAt.ToString("MMM dd, yyyy")
                                        </td>
                                        <td class="text-muted small">
                                            @job.ApplicationDeadline.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            @if (job.JobStatus == "Active")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">@job.JobStatus</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Jobs/Applicants/@job.Id" class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-users me-1"></i> @(job.JobApplications?.Count ?? 0)
                                            </a>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a href="/Jobs/Details/@job.Id" class="btn btn-sm btn-light border" title="View Job Details">
                                                    <i class="fas fa-eye text-muted"></i>
                                                </a>
                                                <a href="/Jobs/Delete/@job.Id" class="btn btn-sm btn-light border" title="Delete Job">
                                                    <i class="fas fa-trash-alt text-danger"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

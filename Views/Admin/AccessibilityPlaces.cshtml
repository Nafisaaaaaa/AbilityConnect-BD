@model IEnumerable<SDP1.Models.AccessibilityPlace>
@{
    ViewData["Title"] = "Manage Accessibility Places";
    var adminName = ViewBag.AdminName ?? "Administrator";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar admin-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile admin-profile">
                    <img src="/images/admin-avatar.png" alt="Admin" class="profile-img" />
                    <h5>@adminName</h5>
                    <span class="badge bg-danger">Administrator</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Admin/ManageUsers"><i class="fas fa-users"></i> Manage Users</a></li>
                    <li><a href="/Admin/VerifyOrganizations"><i class="fas fa-building"></i> Verify Organizations</a></li>
                    <li><a href="/Admin/ManageVolunteers"><i class="fas fa-hand-holding-heart"></i> Manage Volunteers</a></li>
                    <li><a href="/Admin/JobsAndPrograms"><i class="fas fa-briefcase"></i> Jobs & Programs</a></li>
                    <li><a href="/Admin/HealthcareProviders"><i class="fas fa-user-md"></i> Healthcare Providers</a></li>
                    <li class="active"><a href="/Admin/AccessibilityPlaces"><i class="fas fa-map-marked-alt"></i> Accessibility Places</a></li>
                    <li><a href="/Admin/CommunityModeration"><i class="fas fa-comments"></i> Community Moderation</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-map-marked-alt text-primary me-2"></i>Accessibility Places Management</h3>
                    <p class="text-muted mb-0">Total: @Model.Count() places registered with map-ready coordinates & accessibility specs.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Admin/CreateAccessibilityPlace" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-1"></i> Add New Place
                    </a>
                    <a href="/Accessibility" target="_blank" class="btn btn-outline-secondary">
                        <i class="fas fa-external-link-alt me-1"></i> Public Directory
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Place Name & Type</th>
                                <th>Location & Coords</th>
                                <th>Score</th>
                                <th>Ramp</th>
                                <th>Elevator</th>
                                <th>Toilet</th>
                                <th>Parking</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var place in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark">@place.PlaceName</div>
                                        <span class="badge bg-light text-dark border">@place.PlaceType</span>
                                    </td>
                                    <td>
                                        <div class="small">@place.Address</div>
                                        <div class="small text-muted font-monospace">@place.City, @place.District (Lat: @place.Latitude.ToString("F4"), Lng: @place.Longitude.ToString("F4"))</div>
                                    </td>
                                    <td>
                                        <span class="badge @(place.AccessibilityScore >= 80 ? "bg-success" : place.AccessibilityScore >= 60 ? "bg-info text-dark" : "bg-warning text-dark") px-2 py-1">
                                            @place.AccessibilityScore/100
                                        </span>
                                    </td>
                                    <td>
                                        <i class="fas @(place.WheelchairRamp ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                                    </td>
                                    <td>
                                        <i class="fas @(place.Elevator ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                                    </td>
                                    <td>
                                        <i class="fas @(place.AccessibleToilet ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                                    </td>
                                    <td>
                                        <i class="fas @(place.AccessibleParking ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a href="/Accessibility/Details/@place.Id" target="_blank" class="btn btn-sm btn-light border" title="View Public Page">
                                                <i class="fas fa-eye text-muted"></i>
                                            </a>
                                            <a href="/Admin/EditAccessibilityPlace/@place.Id" class="btn btn-sm btn-light border" title="Edit Place">
                                                <i class="fas fa-edit text-primary"></i>
                                            </a>
                                            <form method="post" asp-action="DeleteAccessibilityPlace" asp-route-id="@place.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @place.PlaceName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete Place">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

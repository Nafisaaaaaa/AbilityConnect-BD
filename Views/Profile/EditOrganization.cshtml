@model SDP1.Models.Organization
@{
    ViewData["Title"] = "Edit Organization Profile";
    var orgName = Model.OrganizationName ?? "Organization";
    var logo = !string.IsNullOrEmpty(Model.Logo) ? Model.Logo : "/images/default-org.png";
}

<div class="container-fluid dashboard-container">
    <div class="row">
        <div class="col-md-3 col-lg-2 dashboard-sidebar organization-sidebar">
            <div class="sidebar-menu">
                <div class="user-profile organization-profile">
                    <img src="@logo" alt="Logo" class="profile-img" />
                    <h5>@orgName</h5>
                    <span class="badge bg-primary">Organization</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a href="/Organization/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li><a href="/Jobs/Manage"><i class="fas fa-briefcase"></i> Manage Jobs</a></li>
                    <li><a href="/Healthcare/ManageAppointments"><i class="fas fa-calendar-check"></i> Healthcare</a></li>
                    <li><a href="/Organization/TrainingPrograms"><i class="fas fa-graduation-cap"></i> Training Programs</a></li>
                    <li><a href="/Organization/ManageScholarships"><i class="fas fa-award"></i> Scholarships</a></li>
                    <li><a href="/Organization/ManageEvents"><i class="fas fa-calendar-alt"></i> Awareness Events</a></li>
                    <li><a href="/Community"><i class="fas fa-users"></i> Community Forum</a></li>
                    <li class="active"><a href="/Profile/Edit"><i class="fas fa-user-edit"></i> Edit Profile</a></li>
                    <li><a href="/Profile/ChangePassword"><i class="fas fa-key"></i> Change Password</a></li>
                    <li><a href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
        </div>

        <div class="col-md-9 col-lg-10 dashboard-content">
            <div class="page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-building text-primary me-2"></i> Edit Organization Profile</h3>
                    <p class="text-muted mb-0">Update organization info, office location coordinates, and contact details.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Profile/ChangePassword" class="btn btn-outline-secondary fw-semibold rounded-pill px-3">
                        <i class="fas fa-key me-1"></i> Change Password
                    </a>
                    <a href="/Organization/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                        <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <form asp-action="EditOrganization" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="City" />
                    <input type="hidden" asp-for="Division" />

                    <div class="row g-3">
                        <div class="col-12">
                            <h5 class="fw-bold text-primary mb-3"><i class="fas fa-info-circle me-2"></i>Organization Information</h5>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="OrganizationName" class="form-label fw-semibold">Organization Name *</label>
                                <input asp-for="OrganizationName" class="form-control" required />
                                <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="OrganizationType" class="form-label fw-semibold">Organization Type *</label>
                                <select asp-for="OrganizationType" class="form-select">
                                    <option value="NGO">NGO (Non-Governmental Organization)</option>
                                    <option value="Non-Profit">Non-Profit Organization</option>
                                    <option value="Educational Institution">Educational Institution</option>
                                    <option value="Healthcare Provider">Healthcare Provider</option>
                                    <option value="Corporate / CSR">Corporate / CSR Entity</option>
                                    <option value="Government Agency">Government Agency</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group mb-3">
                                <label asp-for="OrganizationDescription" class="form-label fw-semibold">Description *</label>
                                <textarea asp-for="OrganizationDescription" class="form-control" rows="3" required></textarea>
                                <span asp-validation-for="OrganizationDescription" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="text" class="form-control bg-light" value="@Model.Email" disabled />
                                <small class="text-muted">Email cannot be changed.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number *</label>
                                <input asp-for="PhoneNumber" class="form-control" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <h5 class="fw-bold text-primary mb-3"><i class="fas fa-map-marker-alt me-2"></i>Location & Coordinates</h5>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label asp-for="Address" class="form-label fw-semibold">Location / Office Address *</label>
                                <div class="input-group">
                                    <input asp-for="Address" class="form-control" id="locationInput" placeholder="Enter office address or location" required />
                                    <button type="button" class="btn btn-outline-primary" id="btnDetectLocation" onclick="detectUserLocation()">
                                        <i class="fas fa-crosshairs me-1"></i> Detect Location
                                    </button>
                                </div>
                                <input type="hidden" asp-for="Latitude" id="latitudeInput" />
                                <input type="hidden" asp-for="Longitude" id="longitudeInput" />
                                <div id="locationStatus" class="mt-1 small">
                                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                    {
                                        <span class="text-primary fw-semibold">
                                            <i class="fas fa-check-circle me-1"></i> Saved coordinates: (@Model.Latitude.Value.ToString("F4"), @Model.Longitude.Value.ToString("F4"))
                                        </span>
                                    }
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Website" class="form-label fw-semibold">Website</label>
                                <input asp-for="Website" class="form-control" placeholder="https://www.example.org" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FacebookProfileLink" class="form-label fw-semibold">Facebook Page / Profile Link</label>
                                <input asp-for="FacebookProfileLink" class="form-control" placeholder="https://facebook.com/org" />
                            </div>
                        </div>

                        <div class="col-12">
                            <h5 class="fw-bold text-primary mb-3"><i class="fas fa-user-tie me-2"></i>Contact Person</h5>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ContactPersonName" class="form-label fw-semibold">Contact Person Name *</label>
                                <input asp-for="ContactPersonName" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ContactPersonDesignation" class="form-label fw-semibold">Designation *</label>
                                <input asp-for="ContactPersonDesignation" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ContactPersonPhone" class="form-label fw-semibold">Contact Person Phone *</label>
                                <input asp-for="ContactPersonPhone" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ContactPersonEmail" class="form-label fw-semibold">Contact Person Email *</label>
                                <input asp-for="ContactPersonEmail" class="form-control" type="email" required />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="form-label fw-semibold">Organization Logo</label>
                                <input type="file" name="LogoFile" class="form-control" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.Logo))
                                {
                                    <small class="text-muted d-block mt-1">Current logo: <a href="@Model.Logo" target="_blank">View</a></small>
                                }
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold px-4">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a href="/Organization/Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function detectUserLocation() {
            var btn = document.getElementById('btnDetectLocation');
            var status = document.getElementById('locationStatus');
            var latInput = document.getElementById('latitudeInput');
            var lngInput = document.getElementById('longitudeInput');
            var locInput = document.getElementById('locationInput');

            if (!navigator.geolocation) {
                status.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i> Geolocation is not supported by your browser.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Detecting...';
            status.innerHTML = '<span class="text-muted"><i class="fas fa-circle-notch fa-spin me-1"></i> Requesting location...</span>';

            navigator.geolocation.getCurrentPosition(
                function (position) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Detect Location';
                    var lat = position.coords.latitude.toFixed(6);
                    var lng = position.coords.longitude.toFixed(6);
                    latInput.value = lat;
                    lngInput.value = lng;
                    if (!locInput.value || locInput.value.trim() === '') {
                        locInput.value = lat + ', ' + lng;
                    }
                    status.innerHTML = '<span class="text-primary fw-semibold"><i class="fas fa-check-circle me-1"></i> Location detected! (' + lat + ', ' + lng + ')</span>';
                },
                function (error) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Detect Location';
                    var msg = 'Unable to detect location. Please enter manually.';
                    if (error.code === error.PERMISSION_DENIED) {
                        msg = 'Location permission was denied. Please allow location access.';
                    } else if (error.code === error.POSITION_UNAVAILABLE) {
                        msg = 'Location information unavailable.';
                    } else if (error.code === error.TIMEOUT) {
                        msg = 'Location request timed out.';
                    }
                    status.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i> ' + msg + '</span>';
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        }
    </script>
}

@model SDP1.Models.SavedOpportunitiesViewModel
@{
    ViewData["Title"] = "Saved Opportunities";
    var totalSaved = Model.SavedTrainings.Count + Model.SavedScholarships.Count + Model.SavedEvents.Count;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-bookmark text-primary me-2"></i> Saved Opportunities</h2>
            <p class="text-muted mb-0">Review and keep track of training courses, scholarships, and awareness events you have bookmarked.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Disability/Dashboard" class="btn btn-outline-primary fw-semibold rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <a href="/Services/MyRegistrations" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-clipboard-check me-1"></i> View My Registrations
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-pills mb-4 border-bottom pb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "All" ? "active" : "")" href="/Services/SavedOpportunities?type=All">
                All Items (@totalSaved)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "Training" ? "active" : "")" href="/Services/SavedOpportunities?type=Training">
                <i class="fas fa-graduation-cap me-1"></i> Trainings (@Model.SavedTrainings.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "Scholarship" ? "active" : "")" href="/Services/SavedOpportunities?type=Scholarship">
                <i class="fas fa-award me-1"></i> Scholarships (@Model.SavedScholarships.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "Event" ? "active" : "")" href="/Services/SavedOpportunities?type=Event">
                <i class="fas fa-calendar-alt me-1"></i> Events (@Model.SavedEvents.Count)
            </a>
        </li>
    </ul>

    @if (totalSaved == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="far fa-bookmark fa-4x text-muted mb-3"></i>
                <h4 class="fw-bold">No Saved Opportunities Yet</h4>
                <p class="text-muted mb-4">When you browse training programs, scholarships, or awareness events, click the bookmark icon to save them here for easy access.</p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="/Services/Trainings" class="btn btn-primary"><i class="fas fa-graduation-cap me-1"></i> Browse Trainings</a>
                    <a href="/Services/Scholarships" class="btn btn-outline-primary fw-semibold"><i class="fas fa-award me-1"></i> Browse Scholarships</a>
                    <a href="/Services/Events" class="btn btn-outline-primary fw-semibold"><i class="fas fa-calendar-alt me-1"></i> Browse Events</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @if (Model.CurrentTab == "All" || Model.CurrentTab == "Training")
            {
                @foreach (var item in Model.SavedTrainings)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary">Training: @item.DeliveryMode</span>
                                    <form method="post" action="/Services/ToggleSave">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="Training" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="/Services/SavedOpportunities?type=@Model.CurrentTab" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Remove Bookmark">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a href="/Services/TrainingDetails/@item.Id" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                                </h5>
                                <p class="text-muted small mb-2"><i class="fas fa-building me-1"></i> @(item.Organization?.OrganizationName ?? "Organization")</p>
                                <p class="card-text text-secondary small flex-grow-1 mb-3">
                                    @(item.Description.Length > 100 ? item.Description.Substring(0, 97) + "..." : item.Description)
                                </p>
                                <div class="small text-muted mb-3">
                                    <i class="fas fa-calendar-alt me-1"></i> Starts: @item.StartDate.ToString("MMM dd, yyyy")
                                </div>
                                <a href="/Services/TrainingDetails/@item.Id" class="btn btn-sm btn-outline-primary w-100">
                                    View Training <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (Model.CurrentTab == "All" || Model.CurrentTab == "Scholarship")
            {
                @foreach (var item in Model.SavedScholarships)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary">Scholarship: @item.ScholarshipType</span>
                                    <form method="post" action="/Services/ToggleSave">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="Scholarship" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="/Services/SavedOpportunities?type=@Model.CurrentTab" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Remove Bookmark">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a href="/Services/ScholarshipDetails/@item.Id" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                                </h5>
                                <p class="text-muted small mb-2"><i class="fas fa-building me-1"></i> @(item.Organization?.OrganizationName ?? "Foundation")</p>
                                <p class="card-text text-secondary small flex-grow-1 mb-3">
                                    @(item.Benefits.Length > 100 ? item.Benefits.Substring(0, 97) + "..." : item.Benefits)
                                </p>
                                <div class="small text-muted mb-3">
                                    <i class="fas fa-hourglass-half me-1"></i> Deadline: @item.ApplicationDeadline.ToString("MMM dd, yyyy")
                                </div>
                                <a href="/Services/ScholarshipDetails/@item.Id" class="btn btn-sm btn-outline-primary w-100">
                                    View Scholarship <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (Model.CurrentTab == "All" || Model.CurrentTab == "Event")
            {
                @foreach (var item in Model.SavedEvents)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary">Event: @item.EventType</span>
                                    <form method="post" action="/Services/ToggleSave">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="Event" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="/Services/SavedOpportunities?type=@Model.CurrentTab" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Remove Bookmark">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a href="/Services/EventDetails/@item.Id" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                                </h5>
                                <p class="text-muted small mb-2"><i class="fas fa-building me-1"></i> @(item.Organization?.OrganizationName ?? "Organization")</p>
                                <p class="card-text text-secondary small flex-grow-1 mb-3">
                                    @(item.Description.Length > 100 ? item.Description.Substring(0, 97) + "..." : item.Description)
                                </p>
                                <div class="small text-muted mb-3">
                                    <i class="fas fa-calendar-day me-1"></i> @item.EventDate.ToString("MMM dd, yyyy") (@item.StartTime)
                                </div>
                                <a href="/Services/EventDetails/@item.Id" class="btn btn-sm btn-outline-primary w-100">
                                    View Event <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

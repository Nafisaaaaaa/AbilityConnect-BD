@model SDP1.Models.ScholarshipDetailsViewModel
@{
    ViewData["Title"] = Model.Scholarship.Title;
    var s = Model.Scholarship;
    var userRole = Context.Session.GetString("UserRole");
    var isPastDeadline = DateTime.UtcNow.Date > s.ApplicationDeadline.Date;
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a href="/Services/Scholarships" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to All Scholarships
        </a>
        <a href="@dashboardUrl" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
            <i class="fas fa-home me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary fs-6 me-2">@s.ScholarshipType</span>
                        <span class="badge bg-light text-dark border fs-6">@s.FieldOfStudy</span>
                    </div>
                    @if (userRole == "Disability")
                    {
                        <form method="post" action="/Services/ToggleSave">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="Scholarship" />
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="@(Model.IsSaved ? "fas fa-bookmark text-primary" : "far fa-bookmark") me-1"></i>
                                @(Model.IsSaved ? "Saved" : "Save")
                            </button>
                        </form>
                    }
                </div>

                <h2 class="fw-bold mb-2">@s.Title</h2>
                <p class="text-muted fs-6 mb-4">
                    <i class="fas fa-building text-primary me-1"></i> Provided by: <strong>@(s.Organization?.OrganizationName ?? "Verified Foundation")</strong>
                </p>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-hand-holding-usd me-2 text-primary"></i> Grant & Benefit Coverage</h5>
                <div class="p-3 bg-light rounded mb-4 text-dark" style="line-height: 1.7; white-space: pre-wrap;">@s.Benefits</div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-info-circle me-2 text-primary"></i> About this Scholarship</h5>
                <div class="text-secondary mb-4" style="line-height: 1.7; white-space: pre-wrap;">@s.Description</div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-user-check me-2 text-primary"></i> Eligibility Requirements</h5>
                <div class="p-3 bg-light rounded mb-4 text-dark" style="white-space: pre-wrap;">@s.Eligibility</div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-file-alt me-2 text-primary"></i> Required Academic Credentials</h5>
                <p class="text-secondary mb-4">@s.RequiredQualifications</p>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-phone-alt me-2 text-primary"></i> Inquiries & Contact</h5>
                <p class="text-muted mb-0"><i class="fas fa-envelope-open-text me-2"></i> @s.ContactInfo</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 90px;">
                <h5 class="fw-bold mb-3"><i class="fas fa-award text-primary me-2"></i> Key Details</h5>

                <ul class="list-unstyled mb-4">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-tag me-2"></i> Type:</span>
                        <strong class="text-dark">@s.ScholarshipType</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-book me-2"></i> Subject:</span>
                        <strong class="text-dark">@s.FieldOfStudy</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-hourglass-half me-2"></i> Deadline:</span>
                        <strong class="@(isPastDeadline ? "text-danger" : "text-dark")">@s.ApplicationDeadline.ToString("MMM dd, yyyy")</strong>
                    </li>
                    @if (s.StartDate.HasValue)
                    {
                        <li class="py-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted"><i class="fas fa-calendar-alt me-2"></i> Starts:</span>
                            <strong class="text-dark">@s.StartDate.Value.ToString("MMM dd, yyyy")</strong>
                        </li>
                    }
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-map-marker-alt me-2"></i> Jurisdiction:</span>
                        <strong class="text-dark">@s.Location</strong>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-file-alt me-2"></i> Applicants:</span>
                        <strong class="text-dark">@Model.ApplicationCount Applied</strong>
                    </li>
                </ul>

                @if (Model.HasApplied)
                {
                    var statusColor = Model.ApplicationStatus switch
                    {
                        "Accepted" => "alert-success",
                        "Shortlisted" => "alert-info",
                        "Under Review" => "alert-warning",
                        "Rejected" => "alert-danger",
                        _ => "alert-secondary"
                    };

                    <div class="alert @statusColor mb-0 text-center">
                        <i class="fas fa-check-circle fa-2x mb-2 d-block"></i>
                        <strong>Application Submitted!</strong>
                        <div class="mt-2">
                            Current Status: <span class="badge bg-dark">@Model.ApplicationStatus</span>
                        </div>
                    </div>
                }
                else if (isPastDeadline)
                {
                    <div class="alert alert-secondary text-center mb-0">
                        <i class="fas fa-lock me-1"></i> Applications for this grant are closed.
                    </div>
                }
                else if (userRole == "Disability")
                {
                    <a href="/Services/ApplyScholarship/@s.Id" class="btn btn-primary fw-bold w-100 py-2 fs-6 shadow-sm">
                        <i class="fas fa-file-signature me-1"></i> Apply Online Now
                    </a>
                }
                else if (userRole == null)
                {
                    <a href="/Account/Login?returnUrl=/Services/ScholarshipDetails/@s.Id" class="btn btn-primary fw-bold w-100 py-2">
                        <i class="fas fa-sign-in-alt me-1"></i> Log In to Apply
                    </a>
                    <small class="text-muted text-center d-block mt-2">Only registered disability users can apply.</small>
                }
                else
                {
                    <div class="alert alert-light border text-center mb-0 small">
                        <i class="fas fa-info-circle me-1"></i> Logged in as @userRole. Applications are reserved for candidates with disabilities.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

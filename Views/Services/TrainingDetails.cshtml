@model SDP1.Models.TrainingDetailsViewModel
@{
    ViewData["Title"] = Model.Training.Title;
    var t = Model.Training;
    var userRole = Context.Session.GetString("UserRole");
    var modeBadge = t.DeliveryMode == "Online" ? "bg-primary" : (t.DeliveryMode == "Hybrid" ? "bg-info text-dark" : "bg-primary");
    var isPastDeadline = DateTime.UtcNow.Date > t.RegistrationDeadline.Date;
    var isFull = t.MaxParticipants.HasValue && Model.RegistrationCount >= t.MaxParticipants.Value;
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a href="/Services/Trainings" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to All Training Programs
        </a>
        <a href="@dashboardUrl" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
            <i class="fas fa-home me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <span class="badge @modeBadge fs-6 me-2">@t.DeliveryMode</span>
                        <span class="badge bg-light text-dark border fs-6">@t.TrainingCategory</span>
                    </div>
                    @if (userRole == "Disability")
                    {
                        <form method="post" action="/Services/ToggleSave">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="Training" />
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="@(Model.IsSaved ? "fas fa-bookmark text-primary" : "far fa-bookmark") me-1"></i>
                                @(Model.IsSaved ? "Bookmarked" : "Bookmark")
                            </button>
                        </form>
                    }
                </div>

                <h2 class="fw-bold mb-2">@t.Title</h2>
                <p class="text-muted fs-6 mb-4">
                    <i class="fas fa-building text-primary me-1"></i> Organized by: <strong>@(t.Organization?.OrganizationName ?? "Verified Organization")</strong>
                </p>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-info-circle me-2"></i> About the Training</h5>
                <div class="text-secondary mb-4" style="line-height: 1.7; white-space: pre-wrap;">@t.Description</div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-tools me-2"></i> Skills & Curriculum Covered</h5>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var skill in t.SkillsCovered.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                            <i class="fas fa-check me-1"></i> @skill.Trim()
                        </span>
                    }
                </div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-user-check me-2"></i> Target Audience & Eligibility</h5>
                <div class="p-3 bg-light rounded mb-4 text-dark">
                    <p class="mb-0"><i class="fas fa-check-circle text-success me-2"></i> @t.Eligibility</p>
                </div>

                <h5 class="fw-bold text-primary mb-2"><i class="fas fa-phone-alt me-2"></i> Contact & Questions</h5>
                <p class="text-muted mb-0"><i class="fas fa-envelope-open-text me-2"></i> @t.ContactInfo</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 90px;">
                <h5 class="fw-bold mb-3"><i class="fas fa-clipboard-list text-primary me-2"></i> Course Summary</h5>

                <ul class="list-unstyled mb-4">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-clock me-2"></i> Duration:</span>
                        <strong class="text-dark">@t.Duration</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-calendar-alt me-2"></i> Start Date:</span>
                        <strong class="text-dark">@t.StartDate.ToString("MMM dd, yyyy")</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-calendar-check me-2"></i> End Date:</span>
                        <strong class="text-dark">@t.EndDate.ToString("MMM dd, yyyy")</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-hourglass-half me-2"></i> Deadline:</span>
                        <strong class="@(isPastDeadline ? "text-danger" : "text-dark")">@t.RegistrationDeadline.ToString("MMM dd, yyyy")</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-map-marker-alt me-2"></i> Venue / Link:</span>
                        <strong class="text-dark text-end" style="max-width: 60%;">@t.Location</strong>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-users me-2"></i> Enrolled:</span>
                        <strong class="text-dark">
                            @Model.RegistrationCount @(t.MaxParticipants.HasValue ? $"/ {t.MaxParticipants.Value}" : "")
                        </strong>
                    </li>
                </ul>

                @if (Model.IsRegistered)
                {
                    <div class="alert alert-success d-flex align-items-center mb-3">
                        <i class="fas fa-check-circle fa-2x me-3"></i>
                        <div>
                            <strong>You are enrolled!</strong>
                            <div class="small">The organizer will reach out with session details.</div>
                        </div>
                    </div>
                    <form method="post" action="/Services/CancelTrainingRegistration" onsubmit="return confirm('Are you sure you want to cancel your registration?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="fas fa-times-circle me-1"></i> Cancel Enrollment
                        </button>
                    </form>
                }
                else if (isPastDeadline)
                {
                    <div class="alert alert-secondary text-center mb-0">
                        <i class="fas fa-lock me-1"></i> Registration for this training has closed.
                    </div>
                }
                else if (isFull)
                {
                    <div class="alert alert-warning text-center mb-0">
                        <i class="fas fa-user-friends me-1"></i> This course has reached full capacity.
                    </div>
                }
                else if (userRole == "Disability")
                {
                    <form method="post" action="/Services/RegisterTraining">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6 fw-bold shadow-sm">
                            <i class="fas fa-check-circle me-1"></i> Enroll in this Program (Free)
                        </button>
                    </form>
                }
                else if (userRole == null)
                {
                    <a href="/Account/Login?returnUrl=/Services/TrainingDetails/@t.Id" class="btn btn-primary w-100 py-2 fw-bold">
                        <i class="fas fa-sign-in-alt me-1"></i> Log In to Enroll
                    </a>
                    <small class="text-muted text-center d-block mt-2">Registration is free for registered disability users.</small>
                }
                else
                {
                    <div class="alert alert-light border text-center mb-0 small">
                        <i class="fas fa-info-circle me-1"></i> Logged in as @userRole. Enrollment is open to persons with disabilities.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

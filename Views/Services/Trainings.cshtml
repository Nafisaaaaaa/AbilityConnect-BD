@model SDP1.Models.TrainingListViewModel
@{
    ViewData["Title"] = "Skill Training Programs";
    var userRole = Context.Session.GetString("UserRole");
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1E40AF 0%, #2563EB 50%, #3B82F6 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary px-3 py-2 mb-2 rounded-pill fw-semibold"><i class="fas fa-graduation-cap me-1"></i> Empowerment Through Skills</span>
                <h1 class="display-6 fw-bold mb-2">Vocational & Digital Training Programs</h1>
                <p class="lead mb-0 text-light opacity-90">Explore inclusive, disability-accessible training courses designed by certified organizations to build remote work and industry-ready skills.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="@dashboardUrl" class="btn btn-outline-light fw-semibold rounded-pill px-3 me-2 mb-2">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                @if (userRole == "Disability")
                {
                    <a href="/Services/MyRegistrations" class="btn btn-light text-primary fw-bold shadow-sm me-2 mb-2">
                        <i class="fas fa-clipboard-check me-1"></i> My Registrations
                    </a>
                    <a href="/Services/SavedOpportunities?type=Training" class="btn btn-outline-light shadow-sm mb-2">
                        <i class="fas fa-bookmark me-1"></i> Saved (@Model.SavedTrainingIds.Count)
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted">Search Programs</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchKeyword" class="form-control border-start-0" placeholder="Search by title, skills (e.g. NVDA, HTML), or location..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.AvailableCategories)
                        {
                            <option value="@cat" selected="@(Model.Category == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Mode</label>
                    <select name="deliveryMode" class="form-select">
                        <option value="">All Modes</option>
                        <option value="Online" selected="@(Model.DeliveryMode == "Online")">Online</option>
                        <option value="Offline" selected="@(Model.DeliveryMode == "Offline")">In-Person</option>
                        <option value="Hybrid" selected="@(Model.DeliveryMode == "Hybrid")">Hybrid</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Apply</button>
                    <a href="/Services/Trainings" class="btn btn-outline-secondary" title="Reset Filters"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">Showing <strong>@Model.Trainings.Count</strong> of <strong>@Model.TotalCount</strong> training opportunities</p>
        <div>
            <a href="/Services/Trainings?search=@Model.SearchKeyword&category=@Model.Category&deliveryMode=@Model.DeliveryMode&sort=deadline" class="btn btn-sm @(Model.SortOrder == "deadline" ? "btn-primary" : "btn-outline-secondary") me-1">
                <i class="fas fa-hourglass-half me-1"></i> Deadline Soonest
            </a>
            <a href="/Services/Trainings?search=@Model.SearchKeyword&category=@Model.Category&deliveryMode=@Model.DeliveryMode&sort=startDate" class="btn btn-sm @(Model.SortOrder == "startDate" ? "btn-primary" : "btn-outline-secondary")">
                <i class="fas fa-calendar-alt me-1"></i> Starting Soon
            </a>
        </div>
    </div>

    @if (Model.Trainings.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.Trainings)
            {
                var isRegistered = Model.RegisteredTrainingIds.Contains(item.Id);
                var isSaved = Model.SavedTrainingIds.Contains(item.Id);
                var modeBadge = item.DeliveryMode == "Online" ? "bg-success" : (item.DeliveryMode == "Hybrid" ? "bg-warning text-dark" : "bg-primary");
                var isPastDeadline = DateTime.UtcNow.Date > item.RegistrationDeadline.Date;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @modeBadge">@item.DeliveryMode</span>
                                @if (userRole == "Disability")
                                {
                                    <form method="post" action="/Services/ToggleSave" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="Training" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" title="@(isSaved ? "Remove Bookmark" : "Save Program")">
                                            <i class="@(isSaved ? "fas fa-bookmark text-primary" : "far fa-bookmark text-muted") fa-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            <h5 class="card-title fw-bold mb-1">
                                <a href="/Services/TrainingDetails/@item.Id" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                            </h5>
                            <p class="text-muted small mb-2"><i class="fas fa-building me-1"></i> @(item.Organization?.OrganizationName ?? "Verified Organization")</p>

                            <div class="mb-3">
                                <span class="badge bg-light text-dark border me-1">@item.TrainingCategory</span>
                                <span class="badge bg-light text-secondary border"><i class="fas fa-clock me-1"></i> @item.Duration</span>
                            </div>

                            <p class="card-text text-secondary small flex-grow-1 mb-3">
                                @(item.Description.Length > 120 ? item.Description.Substring(0, 117) + "..." : item.Description)
                            </p>

                            <div class="bg-light p-2 rounded mb-3 small">
                                <div><i class="fas fa-calendar-alt text-primary me-1"></i> <strong>Starts:</strong> @item.StartDate.ToString("MMM dd, yyyy")</div>
                                <div class="@(isPastDeadline ? "text-danger" : "text-dark")">
                                    <i class="fas fa-hourglass-half me-1"></i> <strong>Deadline:</strong> @item.RegistrationDeadline.ToString("MMM dd, yyyy")
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                @if (isRegistered)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                        <i class="fas fa-check-circle me-1"></i> Enrolled
                                    </span>
                                }
                                else if (isPastDeadline)
                                {
                                    <span class="badge bg-secondary">Registration Closed</span>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold"><i class="fas fa-check-circle me-1"></i> Free Registration</span>
                                }
                                <a href="/Services/TrainingDetails/@item.Id" class="btn btn-sm btn-outline-primary fw-semibold">
                                    View Details <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center">
                <ul class="pagination shadow-sm">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/Services/Trainings?search=@Model.SearchKeyword&category=@Model.Category&deliveryMode=@Model.DeliveryMode&sort=@Model.SortOrder&page=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" href="/Services/Trainings?search=@Model.SearchKeyword&category=@Model.Category&deliveryMode=@Model.DeliveryMode&sort=@Model.SortOrder&page=@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Services/Trainings?search=@Model.SearchKeyword&category=@Model.Category&deliveryMode=@Model.DeliveryMode&sort=@Model.SortOrder&page=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="fas fa-graduation-cap fa-4x text-muted mb-3"></i>
                <h4 class="fw-bold">No Training Programs Found</h4>
                <p class="text-muted">Try clearing your filters or check back later for new programs posted by organizations.</p>
                <a href="/Services/Trainings" class="btn btn-primary">Clear All Filters</a>
            </div>
        </div>
    }
</div>

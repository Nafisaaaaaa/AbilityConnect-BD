@model SDP1.Models.EventListViewModel
@{
    ViewData["Title"] = "Awareness Campaigns & Events";
    var userRole = Context.Session.GetString("UserRole");
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1E40AF 0%, #2563EB 50%, #3B82F6 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary px-3 py-2 mb-2 rounded-pill fw-semibold"><i class="fas fa-calendar-alt me-1"></i> Community Engagement</span>
                <h1 class="display-6 fw-bold mb-2">Awareness Campaigns & Events</h1>
                <p class="lead mb-0 text-light opacity-90">Join community webinars, advocacy seminars, accessible job fairs, and disability rights awareness gatherings across Bangladesh.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="@dashboardUrl" class="btn btn-outline-light shadow-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                @if (userRole == "Disability")
                {
                    <a href="/Services/MyRegistrations" class="btn btn-light text-primary fw-bold shadow-sm me-2">
                        <i class="fas fa-clipboard-check me-1"></i> My Events
                    </a>
                    <a href="/Services/SavedOpportunities?type=Event" class="btn btn-outline-light shadow-sm">
                        <i class="fas fa-bookmark me-1"></i> Saved (@Model.SavedEventIds.Count)
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Search Events</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchKeyword" class="form-control border-start-0" placeholder="Search by event title, topic, or venue..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Event Format</label>
                    <select name="eventType" class="form-select">
                        <option value="">All Event Formats</option>
                        @foreach (var et in Model.AvailableEventTypes)
                        {
                            <option value="@et" selected="@(Model.EventType == et)">@et</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary text-white fw-semibold w-100"><i class="fas fa-filter me-1"></i> Filter</button>
                    <a href="/Services/Events" class="btn btn-outline-secondary" title="Reset Filters"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">Showing <strong>@Model.Events.Count</strong> of <strong>@Model.TotalCount</strong> upcoming events</p>
        <div>
            <a href="/Services/Events?search=@Model.SearchKeyword&eventType=@Model.EventType&sort=eventDate" class="btn btn-sm @(Model.SortOrder == "eventDate" ? "btn-primary text-white" : "btn-outline-secondary") me-1">
                <i class="fas fa-calendar-day me-1"></i> Happening Soonest
            </a>
            <a href="/Services/Events?search=@Model.SearchKeyword&eventType=@Model.EventType&sort=deadline" class="btn btn-sm @(Model.SortOrder == "deadline" ? "btn-primary text-white" : "btn-outline-secondary")">
                <i class="fas fa-hourglass-half me-1"></i> Registration Deadline
            </a>
        </div>
    </div>

    @if (Model.Events.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.Events)
            {
                var isRegistered = Model.RegisteredEventIds.Contains(item.Id);
                var isSaved = Model.SavedEventIds.Contains(item.Id);
                var isPastDeadline = DateTime.UtcNow.Date > item.RegistrationDeadline.Date;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary">@item.EventType</span>
                                @if (userRole == "Disability")
                                {
                                    <form method="post" action="/Services/ToggleSave" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="type" value="Event" />
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" title="@(isSaved ? "Remove Bookmark" : "Save Event")">
                                            <i class="@(isSaved ? "fas fa-bookmark text-primary" : "far fa-bookmark text-muted") fa-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            <h5 class="card-title fw-bold mb-1">
                                <a href="/Services/EventDetails/@item.Id" class="text-decoration-none text-dark">@item.Title</a>
                            </h5>
                            <p class="text-muted small mb-2"><i class="fas fa-building me-1"></i> @(item.Organization?.OrganizationName ?? "Host Organization")</p>

                            <div class="bg-light p-3 rounded mb-3 small">
                                <div class="mb-1"><i class="fas fa-calendar-day text-primary me-1"></i> <strong>Date:</strong> @item.EventDate.ToString("MMMM dd, yyyy")</div>
                                <div class="mb-1"><i class="fas fa-clock text-primary me-1"></i> <strong>Time:</strong> @item.StartTime - @item.EndTime</div>
                                <div><i class="fas fa-map-marker-alt text-primary me-1"></i> <strong>Location:</strong> @item.Location</div>
                            </div>

                            <p class="card-text text-secondary small flex-grow-1 mb-3">
                                @(item.Description.Length > 110 ? item.Description.Substring(0, 107) + "..." : item.Description)
                            </p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                @if (isRegistered)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                        <i class="fas fa-check-circle me-1"></i> Registered
                                    </span>
                                }
                                else if (isPastDeadline)
                                {
                                    <span class="badge bg-secondary">Registration Closed</span>
                                }
                                else
                                {
                                    <span class="text-primary small fw-semibold"><i class="fas fa-ticket-alt me-1"></i> Free Entry</span>
                                }
                                <a href="/Services/EventDetails/@item.Id" class="btn btn-sm btn-outline-primary fw-semibold">
                                    Event Details <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center">
                <ul class="pagination shadow-sm">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/Services/Events?search=@Model.SearchKeyword&eventType=@Model.EventType&sort=@Model.SortOrder&page=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" href="/Services/Events?search=@Model.SearchKeyword&eventType=@Model.EventType&sort=@Model.SortOrder&page=@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Services/Events?search=@Model.SearchKeyword&eventType=@Model.EventType&sort=@Model.SortOrder&page=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="fas fa-calendar-alt fa-4x text-muted mb-3"></i>
                <h4 class="fw-bold">No Events Found</h4>
                <p class="text-muted">No awareness events currently match your search criteria. Check back soon for upcoming seminars and webinars.</p>
                <a href="/Services/Events" class="btn btn-primary text-white">Clear All Filters</a>
            </div>
        </div>
    }
</div>

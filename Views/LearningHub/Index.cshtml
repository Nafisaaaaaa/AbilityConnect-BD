@model SDP1.Models.LearningHubIndexViewModel
@{
    ViewData["Title"] = "Learning Hub";
    var userRole = Context.Session.GetString("UserRole");
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 60%, #60A5FA 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary px-3 py-2 mb-2 rounded-pill fw-semibold"><i class="fas fa-book-reader me-1"></i> Free Accessible Education</span>
                <h1 class="display-6 fw-bold mb-2">Disability Learning Hub</h1>
                <p class="lead mb-0 text-light opacity-90">Curated, accessible video lessons across Braille, Sign Language, Computer Literacy, Freelancing, and Digital Independence.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="@dashboardUrl" class="btn btn-outline-light fw-semibold rounded-pill px-3 me-2 mb-2">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                @if (userRole == "Admin")
                {
                    <a href="/Admin/LearningHub" class="btn btn-light text-primary fw-bold shadow-sm mb-2">
                        <i class="fas fa-cog me-1"></i> Manage Hub Content
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-auto">
            <a href="/LearningHub" class="btn @(string.IsNullOrEmpty(Model.SelectedCategory) ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-th-large me-1"></i> All Lessons (@Model.TotalCount)
            </a>
        </div>
        <div class="col-auto">
            <a href="/LearningHub?category=Braille" class="btn @(Model.SelectedCategory == "Braille" ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-braille me-1"></i> Braille (@(Model.CategoryCounts.GetValueOrDefault("Braille", 0)))
            </a>
        </div>
        <div class="col-auto">
            <a href="/LearningHub?category=Sign Language" class="btn @(Model.SelectedCategory == "Sign Language" ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-hands me-1"></i> Sign Language (@(Model.CategoryCounts.GetValueOrDefault("Sign Language", 0)))
            </a>
        </div>
        <div class="col-auto">
            <a href="/LearningHub?category=Computer Skills" class="btn @(Model.SelectedCategory == "Computer Skills" ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-laptop me-1"></i> Computer Skills (@(Model.CategoryCounts.GetValueOrDefault("Computer Skills", 0)))
            </a>
        </div>
        <div class="col-auto">
            <a href="/LearningHub?category=Freelancing" class="btn @(Model.SelectedCategory == "Freelancing" ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-briefcase me-1"></i> Freelancing (@(Model.CategoryCounts.GetValueOrDefault("Freelancing", 0)))
            </a>
        </div>
        <div class="col-auto">
            <a href="/LearningHub?category=Digital Literacy" class="btn @(Model.SelectedCategory == "Digital Literacy" ? "btn-primary shadow-sm" : "btn-outline-primary") rounded-pill px-3">
                <i class="fas fa-mobile-alt me-1"></i> Digital Literacy (@(Model.CategoryCounts.GetValueOrDefault("Digital Literacy", 0)))
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <input type="hidden" name="category" value="@Model.SelectedCategory" />
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Search lessons by topic (e.g. NVDA, Alphabet, Upwork, Screen Reader)..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i> Search</button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory))
                    {
                        <a href="/LearningHub" class="btn btn-outline-secondary" title="Reset"><i class="fas fa-redo"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.Videos.Any())
    {
        <div class="row g-4">
            @foreach (var video in Model.Videos)
            {
                var catIcon = video.Category switch
                {
                    "Braille" => "fas fa-braille",
                    "Sign Language" => "fas fa-hands",
                    "Computer Skills" => "fas fa-laptop",
                    "Freelancing" => "fas fa-briefcase",
                    _ => "fas fa-mobile-alt"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition-all overflow-hidden">
                        <div class="position-relative bg-dark" style="aspect-ratio: 16/9; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(video.ThumbnailUrl))
                            {
                                <img src="@video.ThumbnailUrl" alt="@video.Title" class="w-100 h-100 object-fit-cover opacity-90 hover-zoom" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary text-white">
                                    <i class="fab fa-youtube fa-3x"></i>
                                </div>
                            }
                            <a href="/LearningHub/Watch/@video.Id" class="position-absolute top-50 start-50 translate-middle btn btn-light rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;" aria-label="Watch @video.Title">
                                <i class="fas fa-play text-primary fs-5 ms-1"></i>
                            </a>
                            @if (!string.IsNullOrEmpty(video.Duration))
                            {
                                <span class="position-absolute bottom-0 end-0 bg-dark bg-opacity-75 text-white small px-2 py-1 m-2 rounded">
                                    <i class="fas fa-clock me-1"></i> @video.Duration
                                </span>
                            }
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary">
                                    <i class="@catIcon me-1"></i> @video.Category
                                </span>
                            </div>

                            <h5 class="card-title fw-bold mb-2">
                                <a href="/LearningHub/Watch/@video.Id" class="text-decoration-none text-dark hover-primary">@video.Title</a>
                            </h5>

                            <p class="card-text text-secondary small flex-grow-1 mb-3">
                                @(video.Description.Length > 120 ? video.Description.Substring(0, 117) + "..." : video.Description)
                            </p>

                            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted"><i class="fas fa-video me-1"></i> Video Tutorial</span>
                                <a href="/LearningHub/Watch/@video.Id" class="btn btn-sm btn-primary fw-semibold">
                                    Watch Lesson <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center">
                <ul class="pagination shadow-sm">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/LearningHub?category=@Model.SelectedCategory&search=@Model.SearchQuery&page=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" href="/LearningHub?category=@Model.SelectedCategory&search=@Model.SearchQuery&page=@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/LearningHub?category=@Model.SelectedCategory&search=@Model.SearchQuery&page=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="fas fa-video fa-4x text-muted mb-3"></i>
                <h4 class="fw-bold">No Video Lessons Found</h4>
                <p class="text-muted">No tutorials matched your search criteria or category filter.</p>
                <a href="/LearningHub" class="btn btn-primary">Browse All Lessons</a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .hover-shadow {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }
        .hover-zoom {
            transition: transform 0.3s ease;
        }
        .card:hover .hover-zoom {
            transform: scale(1.05);
        }
        .hover-primary:hover {
            color: #2563EB !important;
        }
    </style>
}

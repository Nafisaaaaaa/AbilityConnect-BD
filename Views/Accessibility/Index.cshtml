@model SDP1.Models.AccessibilityListViewModel
@{
    ViewData["Title"] = "Accessibility Map & Places";
    var userRole = Context.Session.GetString("UserRole");
    var dashboardUrl = userRole switch
    {
        "Disability" => "/Disability/Dashboard",
        "Volunteer" => "/Volunteer/Dashboard",
        "Organization" => "/Organization/Dashboard",
        "Admin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1E40AF 0%, #2563EB 50%, #3B82F6 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-25 mb-3">
                        <i class="fas fa-universal-access"></i>
                        <span class="small fw-semibold">Inclusive Urban Mobility & Accessibility Directory</span>
                    </div>
                    <h1 class="display-6 fw-bold mb-2">Accessibility Map & Places</h1>
                    <p class="lead mb-0 text-white-50">
                        Explore verified accessible public places, hospitals, transit hubs, and commercial centers across Bangladesh. Built with map-ready coordinates and community-verified reporting.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a href="@dashboardUrl" class="btn btn-outline-light fw-semibold rounded-pill px-3 shadow-sm mb-2 d-inline-block">
                        <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                    <div class="bg-white bg-opacity-10 p-3 rounded-3 d-inline-block text-start w-100 mt-1">
                        <div class="small text-white-50">Total Documented Places</div>
                        <div class="h3 fw-bold mb-0">@Model.TotalCount Verified Locations</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <div class="col-lg-4">
                        <label class="form-label small fw-semibold text-muted">Search Places</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Search by name, address, keywords..." value="@Model.SearchKeyword" />
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label small fw-semibold text-muted">Place Type</label>
                        <select name="placeType" class="form-select bg-light">
                            <option value="">All Types</option>
                            @foreach (var type in Model.AvailableTypes)
                            {
                                <option value="@type" selected="@(Model.PlaceType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label small fw-semibold text-muted">City</label>
                        <select name="city" class="form-select bg-light">
                            <option value="">All Cities</option>
                            @foreach (var c in Model.AvailableCities)
                            {
                                <option value="@c" selected="@(Model.City == c)">@c</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label small fw-semibold text-muted">District</label>
                        <select name="district" class="form-select bg-light">
                            <option value="">All Districts</option>
                            @foreach (var d in Model.AvailableDistricts)
                            {
                                <option value="@d" selected="@(Model.District == d)">@d</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label small fw-semibold text-muted">Sort By</label>
                        <select name="sortOrder" class="form-select bg-light">
                            <option value="score_desc" selected="@(Model.SortOrder == "score_desc")">Highest Score</option>
                            <option value="score_asc" selected="@(Model.SortOrder == "score_asc")">Lowest Score</option>
                            <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Name (A-Z)</option>
                            <option value="newest" selected="@(Model.SortOrder == "newest")">Newest Added</option>
                        </select>
                    </div>
                </div>

                <div class="pt-3 mt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <span class="small fw-bold text-dark me-1"><i class="fas fa-filter text-primary me-1"></i>Accessibility Features:</span>
                        
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="ramp" id="rampCheck" value="true" checked="@(Model.WheelchairRamp == true)" />
                            <label class="form-check-label small" for="rampCheck"><i class="fas fa-wheelchair text-primary me-1"></i>Wheelchair Ramp</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="elevator" id="elevatorCheck" value="true" checked="@(Model.Elevator == true)" />
                            <label class="form-check-label small" for="elevatorCheck"><i class="fas fa-sort-numeric-up-alt text-info me-1"></i>Elevator</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="toilet" id="toiletCheck" value="true" checked="@(Model.AccessibleToilet == true)" />
                            <label class="form-check-label small" for="toiletCheck"><i class="fas fa-restroom text-success me-1"></i>Accessible Toilet</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="parking" id="parkingCheck" value="true" checked="@(Model.AccessibleParking == true)" />
                            <label class="form-check-label small" for="parkingCheck"><i class="fas fa-parking text-warning me-1"></i>Accessible Parking</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Accessibility" class="btn btn-outline-secondary btn-sm px-3">Reset</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">Apply Filters</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            Available Locations (@Model.TotalCount)
        </h5>
        <a href="/Community/Report?type=Location" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-flag me-1"></i>Report Location Issue
        </a>
    </div>

    @if (!Model.Places.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mb-3 text-muted" style="font-size: 3rem;">
                <i class="fas fa-map-marked-alt text-muted opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark">No Accessibility Places Found</h4>
            <p class="text-muted max-w-md mx-auto">
                No locations match your current search or filter criteria. Try adjusting your filters or resetting the search keywords.
            </p>
            <div class="mt-2">
                <a href="/Accessibility" class="btn btn-primary px-4">Reset All Filters</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var place in Model.Places)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white hover-card transition-all">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
                            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                <i class="fas fa-building me-1"></i>@place.PlaceType
                            </span>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted me-1">Score:</span>
                                <span class="badge @(place.AccessibilityScore >= 80 ? "bg-success" : place.AccessibilityScore >= 60 ? "bg-info text-dark" : "bg-warning text-dark") fs-6 px-2 py-1">
                                    @place.AccessibilityScore/100
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="fw-bold text-dark mb-2">
                                <a href="/Accessibility/Details/@place.Id" class="text-dark text-decoration-none hover-primary">
                                    @place.PlaceName
                                </a>
                            </h5>
                            
                            <p class="text-muted small mb-3">
                                <i class="fas fa-map-marker-alt text-danger me-1"></i>@place.Address, @place.City, @place.District
                            </p>

                            <p class="text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @place.Description
                            </p>

                            <div class="p-2 rounded-3 bg-light border mb-3 small d-flex justify-content-between align-items-center">
                                <span class="text-muted">
                                    <i class="fas fa-crosshairs text-primary me-1"></i>Coords:
                                </span>
                                <span class="font-monospace text-dark fw-semibold">
                                    @place.Latitude.ToString("F4"), @place.Longitude.ToString("F4")
                                </span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge @(place.WheelchairRamp ? "bg-success-subtle text-success border border-success" : "bg-light text-muted border") px-2 py-1">
                                    <i class="fas fa-wheelchair me-1"></i> Ramp: @(place.WheelchairRamp ? "Yes" : "No")
                                </span>
                                <span class="badge @(place.Elevator ? "bg-success-subtle text-success border border-success" : "bg-light text-muted border") px-2 py-1">
                                    <i class="fas fa-sort-numeric-up me-1"></i> Elevator: @(place.Elevator ? "Yes" : "No")
                                </span>
                                <span class="badge @(place.AccessibleToilet ? "bg-success-subtle text-success border border-success" : "bg-light text-muted border") px-2 py-1">
                                    <i class="fas fa-restroom me-1"></i> Toilet: @(place.AccessibleToilet ? "Yes" : "No")
                                </span>
                                <span class="badge @(place.AccessibleParking ? "bg-success-subtle text-success border border-success" : "bg-light text-muted border") px-2 py-1">
                                    <i class="fas fa-parking me-1"></i> Parking: @(place.AccessibleParking ? "Yes" : "No")
                                </span>
                            </div>

                            <a href="/Accessibility/Details/@place.Id" class="btn btn-outline-primary w-100 rounded-3 mt-auto">
                                <i class="fas fa-info-circle me-1"></i> View Details & Community Reports
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Accessibility places pagination" class="my-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchKeyword, placeType = Model.PlaceType, city = Model.City, district = Model.District, ramp = Model.WheelchairRamp, elevator = Model.Elevator, toilet = Model.AccessibleToilet, parking = Model.AccessibleParking, sortOrder = Model.SortOrder })">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.SearchKeyword, placeType = Model.PlaceType, city = Model.City, district = Model.District, ramp = Model.WheelchairRamp, elevator = Model.Elevator, toilet = Model.AccessibleToilet, parking = Model.AccessibleParking, sortOrder = Model.SortOrder })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchKeyword, placeType = Model.PlaceType, city = Model.City, district = Model.District, ramp = Model.WheelchairRamp, elevator = Model.Elevator, toilet = Model.AccessibleToilet, parking = Model.AccessibleParking, sortOrder = Model.SortOrder })">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
    }
</style>

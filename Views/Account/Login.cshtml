@{
    ViewData["Title"] = "Login";
}

@model SDP1.Models.LoginViewModel

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="auth-card">
                    <div class="auth-header">
                        <div class="auth-logo">
                            <i class="fas fa-hand-holding-heart"></i>
                        </div>
                        <h3>Welcome Back</h3>
                        <p class="text-muted">Login to access your dashboard</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">
                                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        
                        <div class="form-group">
                            <label asp-for="Email" class="form-label">
                                <i class="fas fa-envelope"></i> Email Address
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" id="emailInput" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock"></i> Password
                            </label>
                            <div class="password-wrapper">
                                <input asp-for="Password" class="form-control" placeholder="Enter your password" type="password" id="passwordInput" />
                                <button type="button" class="password-toggle" onclick="togglePassword('passwordInput', 'passwordToggleIcon')">
                                    <i class="fas fa-eye" id="passwordToggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="text-end mt-1">
                                <a href="/Account/ForgotPassword" class="small">Forgot Password?</a>
                            </div>
                        </div>

                        <div class="form-group" id="roleSelectionGroup">
                            <label class="form-label">
                                <i class="fas fa-user-tag"></i> Select Your Role
                            </label>
                            <div class="role-selector">
                                <div class="role-option" data-role="Disability" onclick="selectRole('Disability')">
                                    <i class="fas fa-wheelchair"></i>
                                    <span>Disability</span>
                                </div>
                                <div class="role-option" data-role="Volunteer" onclick="selectRole('Volunteer')">
                                    <i class="fas fa-hands-helping"></i>
                                    <span>Volunteer</span>
                                </div>
                                <div class="role-option" data-role="Organization" onclick="selectRole('Organization')">
                                    <i class="fas fa-building"></i>
                                    <span>Organization</span>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Role" id="selectedRole" />
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="form-group form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </button>

                        <div class="auth-links">
                            <p>
                                Don't have an account?
                                <a href="/Account/DisabilityRegister">Register as Disability</a> |
                                <a href="/Account/VolunteerRegister">Register as Volunteer</a> |
                                <a href="/Account/OrganizationRegister">Register as Organization</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                window.addEventListener('DOMContentLoaded', function() {
                    showToast('@Html.Raw(TempData["ErrorMessage"])', 'error');
                });
            </text>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                window.addEventListener('DOMContentLoaded', function() {
                    showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');
                });
            </text>
        }

        var ADMIN_EMAIL = 'admin@abilityconnect.com';
        var emailInput = document.getElementById('emailInput');
        var roleGroup = document.getElementById('roleSelectionGroup');
        var selectedRole = document.getElementById('selectedRole');

        function checkAdminEmail() {
            var email = (emailInput.value || '').trim().toLowerCase();
            if (email === ADMIN_EMAIL) {
                roleGroup.style.display = 'none';
                selectedRole.value = '';
            } else {
                roleGroup.style.display = 'block';
            }
        }

        emailInput.addEventListener('input', checkAdminEmail);
        emailInput.addEventListener('change', checkAdminEmail);
        emailInput.addEventListener('blur', checkAdminEmail);
        document.addEventListener('DOMContentLoaded', checkAdminEmail);
        setTimeout(checkAdminEmail, 100);

        function selectRole(role) {
            if (selectedRole) selectedRole.value = role;
            var roleOptions = document.querySelectorAll('.role-option');
            roleOptions.forEach(function (el) {
                el.classList.remove('selected');
                if (el.dataset.role === role) el.classList.add('selected');
            });
        }

        function togglePassword(inputId, toggleId) {
            var passwordInput = document.getElementById(inputId);
            var toggleIcon = document.getElementById(toggleId);
            if (!passwordInput || !toggleIcon) return;
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.className = 'fas fa-eye-slash';
            } else {
                passwordInput.type = 'password';
                toggleIcon.className = 'fas fa-eye';
            }
        }
    </script>
}